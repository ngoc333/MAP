@inherits BasePage
@namespace MAP.M.LogViewer.Pages
@inject ILogStore LogStore

<div class="max-w-7xl">
    <RadzenStack Gap="1rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Wrap="FlexWrap.Wrap">
            <RadzenDropDown TValue="DateOnly?" Data="_days" @bind-Value="_selectedDay" Placeholder="@Lang.T("LogViewer.selectDay")" Style="width: 180px;" />
            <RadzenDropDown TValue="string" Data="Levels" @bind-Value="_level" Placeholder="@Lang.T("LogViewer.level")" Style="width: 150px;" />
            <RadzenTextBox @bind-Value="_search" Placeholder="@Lang.T("LogViewer.search")" Style="width: min(360px, 100%);" />
            <RadzenButton Text="@Lang.T("LogViewer.refresh")" Icon="refresh" Click="LoadAsync" />
            <RadzenButton Text="@Lang.T("LogViewer.clearDay")" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="ClearAsync" Disabled="@(_selectedDay is null)" />
        </RadzenStack>

        <RadzenDataGrid Data="FilteredEntries" TItem="LogEntry" AllowPaging="true" PageSize="50" AllowSorting="true" Responsive="true">
            <Columns>
                <RadzenDataGridColumn TItem="LogEntry" Property="Timestamp" Title="@Lang.T("LogViewer.timestamp")" Width="190px" FormatString="{0:yyyy-MM-dd HH:mm:ss.fff}" />
                <RadzenDataGridColumn TItem="LogEntry" Property="Level" Title="@Lang.T("LogViewer.level")" Width="110px" />
                <RadzenDataGridColumn TItem="LogEntry" Property="Category" Title="Category" Width="230px" />
                <RadzenDataGridColumn TItem="LogEntry" Property="Message" Title="@Lang.T("LogViewer.message")" />
                <RadzenDataGridColumn TItem="LogEntry" Title="@Lang.T("LogViewer.detail")" Width="100px">
                    <Template Context="entry">
                        <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => _selectedEntry = entry)" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        @if (_selectedEntry is not null)
        {
            <RadzenCard class="p-4">
                <RadzenStack Gap="0.5rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1">@_selectedEntry.Timestamp.ToString("O") | @_selectedEntry.Level</RadzenText>
                    <pre class="whitespace-pre-wrap break-words text-xs m-0">Category: @_selectedEntry.Category
Event: @_selectedEntry.EventName
SessionId: @_selectedEntry.SessionId
OperationId: @_selectedEntry.OperationId

@_selectedEntry.Message

@_selectedEntry.Exception</pre>
                </RadzenStack>
            </RadzenCard>
        }
    </RadzenStack>
</div>

@code {
    private static readonly string[] Levels = ["", "Information", "Warning", "Error", "Critical"];
    private IReadOnlyList<DateOnly> _days = [];
    private IReadOnlyList<LogEntry> _entries = [];
    private DateOnly? _selectedDay;
    private string _level = string.Empty;
    private string _search = string.Empty;
    private LogEntry? _selectedEntry;

    protected override string HeaderTitleKey => "LogViewer.title";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private IEnumerable<LogEntry> FilteredEntries => _entries.Where(entry =>
        (string.IsNullOrEmpty(_level) || entry.Level == _level) &&
        (string.IsNullOrWhiteSpace(_search) || Contains(entry.Message, _search) || Contains(entry.Category, _search) || Contains(entry.SessionId, _search) || Contains(entry.OperationId, _search)));

    private async Task LoadAsync()
    {
        _days = await LogStore.GetDaysAsync();
        _selectedDay ??= _days.FirstOrDefault();
        _entries = await LogStore.GetAsync(_selectedDay);
        _selectedEntry = null;
    }

    private async Task ClearAsync()
    {
        if (_selectedDay is null) return;
        await LogStore.ClearAsync(_selectedDay);
        await LoadAsync();
    }

    private static bool Contains(string? value, string query) => value?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;
}
