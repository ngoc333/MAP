@inherits BasePage
@namespace MAP.M.Products.Pages

<div class="p-2">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">@Lang.T("ProductAdd.headerTitle")</h2>

    @if (PageParameters is not null)
    {
        dynamic p = PageParameters;
        <div class="mb-4">
            <RadzenAlert AlertStyle="AlertStyle.Info">
                <strong>@Lang.T("ProductAdd.editingProduct"):</strong> @p.Id (@p.Name) - @p.Category
            </RadzenAlert>
        </div>
    }

    <RadzenCard class="p-6 max-w-2xl">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <RadzenLabel Text="@Lang.T("ProductAdd.productId")" />
                <RadzenTextBox @bind-Value="product.Id" class="w-full" Placeholder="@Lang.T("ProductAdd.placeholderId")" />
            </div>
            <div>
                <RadzenLabel Text="@Lang.T("ProductAdd.productName")" />
                <RadzenTextBox @bind-Value="product.Name" class="w-full" Placeholder="@Lang.T("ProductAdd.placeholderName")" />
            </div>
            <div>
                <RadzenLabel Text="@Lang.T("ProductAdd.category")" />
                <RadzenDropDown @bind-Value="product.Category" Data="@categories" class="w-full"
                    Placeholder="@Lang.T("ProductAdd.selectCategory")" />
            </div>
            <div>
                <RadzenLabel Text="@Lang.T("ProductAdd.price")" />
                <RadzenNumeric @bind-Value="product.Price" class="w-full" Min="0" />
            </div>
            <div>
                <RadzenLabel Text="@Lang.T("ProductAdd.stock")" />
                <RadzenNumeric @bind-Value="product.Stock" class="w-full" Min="0" />
            </div>
            <div class="flex items-end gap-2">
                <RadzenButton Text="@Lang.T("ProductAdd.save")" ButtonStyle="ButtonStyle.Primary" Icon="save"
                    Click="@SaveProduct" />
                <RadzenButton Text="@Lang.T("ProductAdd.backToList")" ButtonStyle="ButtonStyle.Secondary"
                    Click="@(() => OpenPageAsync("product-list"))" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" Text="@message" class="mt-4" />
        }
    </RadzenCard>
</div>

@code {
    protected override string HeaderTitleKey => "ProductAdd.headerTitle";

    private string message = "";

    private class ProductForm
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public double Price { get; set; }
        public int Stock { get; set; }
    }

    private ProductForm product = new();
    private List<string> categories = new() { "Điện tử", "Điện thoại", "Máy tính bảng", "Phụ kiện", "Âm thanh", "Màn hình", "Thiết bị đeo" };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (PageParameters is not null)
        {
            dynamic p = PageParameters;
            product.Id = (string)p.Id;
            product.Name = (string)p.Name;
            product.Category = (string)p.Category;
        }
    }

    private void SaveProduct()
    {
        message = $"{Lang.T("ProductAdd.savedMessage")}: {product.Name} - {product.Price:N0} ₫";
        product = new();
    }
}
