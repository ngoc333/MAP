@inherits BasePage
@namespace MAP.M.System.Pages

<RadzenTabs>
    <Tabs>
        <RadzenTabsItem Text="@Lang.T("MenuRegistration.pagesTab")">
            <RadzenStack Gap=".75rem">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Gap=".5rem"
                             Wrap="FlexWrap.Wrap">
                    <RadzenTextBox Immediate="true"
                                   @bind-Value="_search"
                                   Placeholder="@Lang.T("MenuRegistration.search")"
                                   Style="min-width:240px;" />
                    <RadzenCheckBox @bind-Value="_includeInactive" />
                    <RadzenLabel Text="@Lang.T("MenuRegistration.includeInactive")" />
                    <RadzenButton Text="@Lang.T("MenuRegistration.refresh")"
                                  Icon="refresh"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="RefreshPagesAsync" />
                    <RadzenButton Text="@Lang.T("MenuRegistration.add")"
                                  Icon="add"
                                  Click="AddPageAsync" />
                    <RadzenButton Text="@Lang.T("MenuRegistration.save")"
                                  Icon="save"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Disabled="@(_savingPages || !HasPageChanges)"
                                  Click="SavePagesAsync" />
                </RadzenStack>

                <RadzenDataGrid @ref="_pageGrid"
                                Data="@_pages"
                                Count="@_pageCount"
                                TItem="PageRegistration"
                                LoadData="LoadPagesAsync"
                                CellClick="EditPageCellAsync"
                                EditMode="DataGridEditMode.Multiple"
                                IsLoading="@_pagesLoading"
                                AllowVirtualization="true"
                                VirtualizationOverscanCount="5"
                                PageSize="50"
                                AllowColumnResize="true"
                                Style="height:55vh; min-height:340px; width:100%;">
                    <Columns>
                        <RadzenDataGridColumn TItem="PageRegistration" Property="PageId" Title="Page ID" Width="210px" IsInEditMode="@IsPageCellInEditMode" />
                        <RadzenDataGridColumn TItem="PageRegistration" Property="TitleVi" Title="VI" Width="210px" IsInEditMode="@IsPageCellInEditMode" />
                        <RadzenDataGridColumn TItem="PageRegistration" Property="TitleEn" Title="EN" Width="210px" IsInEditMode="@IsPageCellInEditMode" />
                        <RadzenDataGridColumn TItem="PageRegistration" Property="Icon" Title="Icon" Width="150px" IsInEditMode="@IsPageCellInEditMode" />
                        <RadzenDataGridColumn TItem="PageRegistration" Property="AssemblyName" Title="Assembly" Width="230px" IsInEditMode="@IsPageCellInEditMode" />
                        <RadzenDataGridColumn TItem="PageRegistration" Property="ComponentName" Title="Component" Width="320px" IsInEditMode="@IsPageCellInEditMode" />
                        <RadzenDataGridColumn TItem="PageRegistration" Property="Note" Title="Note" Width="220px" IsInEditMode="@IsPageCellInEditMode" />
                        <RadzenDataGridColumn TItem="PageRegistration" Property="IsActive" Title="Active" Width="90px" TextAlign="TextAlign.Center" IsInEditMode="@IsPageCellInEditMode" />
                    </Columns>
                </RadzenDataGrid>
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="@Lang.T("MenuRegistration.programsTab")">
            <RadzenStack Gap=".75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap=".5rem" Wrap="FlexWrap.Wrap">
                    <RadzenDropDown TValue="string" Data="@_programs" TextProperty="ProgramId" ValueProperty="ProgramId" @bind-Value="_selectedProgramId" Change="LoadProgramAsync" Placeholder="Program" Style="min-width:220px;" />
                    <RadzenButton Text="@Lang.T("MenuRegistration.newProgram")" Icon="add" Click="NewProgram" />
                    <RadzenButton Text="@Lang.T("MenuRegistration.refresh")" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="LoadProgramsAsync" />
                    <RadzenButton Text="@Lang.T("MenuRegistration.addMenu")" Icon="playlist_add" Disabled="@(_program is null || _useDefaultMenu || _savingProgram)" Click="AddMenuRowAsync" />
                    <RadzenButton Text="@Lang.T("MenuRegistration.save")" Icon="save" ButtonStyle="ButtonStyle.Primary" Disabled="@(_program is null || _savingProgram)" Click="SaveProgramAsync" />
                </RadzenStack>
            </RadzenStack>
        </RadzenTabsItem>

        @if (MenuService.SupportsLocalConfigEditing)
        {
            <RadzenTabsItem Text="@Lang.T("MenuRegistration.localTab")">
                <RadzenStack Gap=".75rem">
                    <RadzenAlert AlertStyle="AlertStyle.Info">@Lang.T("MenuRegistration.localInfo")</RadzenAlert>
                    <RadzenText Text="@MenuService.LocalConfigLocation" />
                    <RadzenTextArea @bind-Value="_localPageJson" Rows="24" Style="width:100%; font-family:monospace;" />
                    <RadzenStack Orientation="Orientation.Horizontal" Gap=".5rem">
                        <RadzenButton Text="@Lang.T("MenuRegistration.reloadLocal")" Icon="refresh" Click="LoadLocalConfigAsync" />
                        <RadzenButton Text="@Lang.T("MenuRegistration.saveLocal")" Icon="save" Disabled="@_savingLocal" Click="SaveLocalConfigAsync" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTabsItem>
        }
    </Tabs>
</RadzenTabs>

@code {
    private List<PageRegistration> _pages = [];
    private List<PageRegistration> _pageOptions = [];
    private List<ProgramRegistration> _programs = [];
    private List<MenuRegistrationRow> _menuRows = [];
    private ProgramRegistration? _program;
    private string? _selectedProgramId;
    private string? _search;
    private bool _includeInactive = true;
    private bool _useDefaultMenu;
    private bool _savingPages;
    private bool _savingProgram;
    private bool _savingLocal;
    private bool _pagesLoading;
    private int _pageCount;
    private string _localPageJson = "";
    private RadzenDataGrid<PageRegistration>? _pageGrid;
    private readonly HashSet<string> _dirtyPages = [];

    protected override string HeaderTitleKey => "MenuRegistration.title";
    private bool HasPageChanges => _dirtyPages.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadPageOptionsAsync();
        await LoadProgramsAsync();
        await LoadLocalConfigAsync();
    }

    private async Task LoadPagesAsync(LoadDataArgs args)
    {
        _pagesLoading = true;
        try
        {
            var rows = await QueryAsync<PageRegistration>("mes.map_page_search_f", new { PSearch = _search, PIncludeInactive = _includeInactive, PSkip = args.Skip ?? 0, PTake = args.Top ?? 50 });
            _pages = rows;
            _pageCount = rows.FirstOrDefault()?.TotalCount ?? 0;
        }
        finally { _pagesLoading = false; }
    }

    private async Task RefreshPagesAsync() { if (_pageGrid is not null) await _pageGrid.Reload(); }
    private async Task LoadPageOptionsAsync() => _pageOptions = await QueryAsync<PageRegistration>("mes.map_page_list_f", new { PSearch = (string?)null, PIncludeInactive = true });
    private Task AddPageAsync() => Task.CompletedTask;
    private Task EditPageCellAsync(DataGridCellMouseEventArgs<PageRegistration> args) => Task.CompletedTask;
    private bool IsPageCellInEditMode(string property, PageRegistration page) => false;
    private Task SavePagesAsync() => Task.CompletedTask;
    private Task AddMenuRowAsync() => Task.CompletedTask;
    private Task LoadProgramAsync(object? value = null) => Task.CompletedTask;
    private Task LoadProgramsAsync() => Task.CompletedTask;
    private void NewProgram() { }
    private Task SaveProgramAsync() => Task.CompletedTask;

    private async Task LoadLocalConfigAsync()
    {
        if (!MenuService.SupportsLocalConfigEditing) return;
        _localPageJson = await MenuService.ReadLocalConfigAsync() ?? "";
    }

    private async Task SaveLocalConfigAsync()
    {
        if (!MenuService.SupportsLocalConfigEditing) return;
        try
        {
            _savingLocal = true;
            await MenuService.SaveLocalConfigAsync(_localPageJson);
            await LoadLocalConfigAsync();
            NotifySuccess(Lang.T("MenuRegistration.localSaveSuccess"));
        }
        catch (Exception ex) { NotifyError(ex.Message); }
        finally { _savingLocal = false; }
    }
}
