@inherits BasePage
@namespace MAP.M.Home.Pages

<div class="p-2">
    <h2 class="text-2xl font-bold text-gray-800 mb-4">@Lang.T("HomePage.intro")</h2>

    <RadzenCard class="p-6 max-w-3xl">
        <h3 class="text-xl font-semibold text-gray-700 mb-3">@Lang.T("HomePage.welcome")</h3>
        <p class="text-gray-600 mb-4">
            @Lang.T("HomePage.description")
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div class="border border-blue-200 rounded-lg p-4 bg-blue-50">
                <RadzenIcon Icon="bolt" class="text-2xl text-blue-500 mb-2" />
                <h4 class="font-semibold text-gray-700">@Lang.T("HomePage.lazyLoading")</h4>
                <p class="text-sm text-gray-500">@Lang.T("HomePage.lazyLoadingDesc")</p>
            </div>
            <div class="border border-green-200 rounded-lg p-4 bg-green-50">
                <RadzenIcon Icon="extension" class="text-2xl text-green-500 mb-2" />
                <h4 class="font-semibold text-gray-700">@Lang.T("HomePage.independentModule")</h4>
                <p class="text-sm text-gray-500">@Lang.T("HomePage.independentModuleDesc")</p>
            </div>
            <div class="border border-purple-200 rounded-lg p-4 bg-purple-50">
                <RadzenIcon Icon="dashboard_customize" class="text-2xl text-purple-500 mb-2" />
                <h4 class="font-semibold text-gray-700">@Lang.T("HomePage.radzenComponents")</h4>
                <p class="text-sm text-gray-500">@Lang.T("HomePage.radzenComponentsDesc")</p>
            </div>
            <div class="border border-orange-200 rounded-lg p-4 bg-orange-50">
                <RadzenIcon Icon="palette" class="text-2xl text-orange-500 mb-2" />
                <h4 class="font-semibold text-gray-700">@Lang.T("HomePage.tailwindcss")</h4>
                <p class="text-sm text-gray-500">@Lang.T("HomePage.tailwindcssDesc")</p>
            </div>
        </div>

        <div class="mt-6 border-t pt-4">
            <h4 class="font-semibold text-gray-700 mb-3">@Lang.T("HomePage.testNav")</h4>
            <div class="flex flex-wrap gap-3">
                <RadzenButton Text="@Lang.T("HomePage.openDashboard")" ButtonStyle="ButtonStyle.Primary"
                    Click="@(() => Navigator.OpenAsync("home-dashboard"))" />
                <RadzenButton Text="@Lang.T("HomePage.openCustomerList")" ButtonStyle="ButtonStyle.Secondary"
                    Click="@(() => Navigator.OpenAsync("customer-list"))" />
                <RadzenButton Text="@Lang.T("HomePage.openCustomerDetail")" ButtonStyle="ButtonStyle.Secondary"
                    Click="@(() => Navigator.OpenAsync("customer-detail", new { Code = "KH999", FullName = "Test User", Email = "test@test.com", Phone = "000", City = "Test", TotalOrders = 0 }))" />
                <RadzenButton Text="@Lang.T("HomePage.openProductAdd")" ButtonStyle="ButtonStyle.Secondary"
                    Click="@(() => Navigator.OpenAsync("product-add", new { Id = "SP-NEW", Name = "Sản phẩm test", Category = "Điện tử" }))" />
                <RadzenButton Text="@Lang.T("HomePage.openSales")" ButtonStyle="ButtonStyle.Light"
                    Click="@(() => Navigator.OpenAsync("report-sales"))" />
            </div>
        </div>
    </RadzenCard>
</div>

@code {
    protected override string HeaderTitleKey => "HomePage.headerTitle";
}
