@inherits BasePage
@namespace MAP.M.Home.Pages

<div class="p-2">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Dashboard</h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <RadzenCard class="p-4 cursor-pointer hover:shadow-md transition-shadow"
            Click="@(() => Navigator.OpenAsync("product-list"))">
            <div class="flex items-center gap-4">
                <RadzenIcon Icon="shopping_cart" class="text-4xl text-blue-500" />
                <div>
                    <p class="text-sm text-gray-500">Tổng đơn hàng</p>
                    <p class="text-2xl font-bold text-gray-800">1,245</p>
                </div>
            </div>
        </RadzenCard>

        <RadzenCard class="p-4 cursor-pointer hover:shadow-md transition-shadow"
            Click="@(() => Navigator.OpenAsync("report-sales"))">
            <div class="flex items-center gap-4">
                <RadzenIcon Icon="trending_up" class="text-4xl text-green-500" />
                <div>
                    <p class="text-sm text-gray-500">Doanh thu</p>
                    <p class="text-2xl font-bold text-gray-800">₫856M</p>
                </div>
            </div>
        </RadzenCard>

        <RadzenCard class="p-4 cursor-pointer hover:shadow-md transition-shadow"
            Click="@(() => Navigator.OpenAsync("customer-list"))">
            <div class="flex items-center gap-4">
                <RadzenIcon Icon="people" class="text-4xl text-purple-500" />
                <div>
                    <p class="text-sm text-gray-500">Khách hàng</p>
                    <p class="text-2xl font-bold text-gray-800">328</p>
                </div>
            </div>
        </RadzenCard>
    </div>

    <RadzenCard class="p-4">
        <h3 class="text-lg font-semibold text-gray-700 mb-4">Doanh thu theo tháng</h3>
        <RadzenChart>
            <RadzenColumnSeries Data="@revenueData" CategoryProperty="Month" ValueProperty="Amount"
                Fill="var(--rz-primary)">
            </RadzenColumnSeries>
            <RadzenCategoryAxis />
            <RadzenValueAxis />
            <RadzenColumnOptions Radius="4" />
        </RadzenChart>
    </RadzenCard>
</div>

@code {
    protected override string HeaderTitle => "Dashboard";

    private class RevenueItem
    {
        public string Month { get; set; } = "";
        public double Amount { get; set; }
    }

    private RevenueItem[] revenueData = new[]
    {
        new RevenueItem { Month = "T1", Amount = 65 },
        new RevenueItem { Month = "T2", Amount = 59 },
        new RevenueItem { Month = "T3", Amount = 80 },
        new RevenueItem { Month = "T4", Amount = 81 },
        new RevenueItem { Month = "T5", Amount = 56 },
        new RevenueItem { Month = "T6", Amount = 95 },
        new RevenueItem { Month = "T7", Amount = 72 },
    };
}
