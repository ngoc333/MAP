# MAP local release configuration
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# UNC or local deployment root. Desktop files deploy to its desktop subdirectory.
MAP_DESKTOP_DEPLOY_PATH=your_value_here

# Self-contained Desktop publish runtime. Defaults to win-x64 when omitted.
MAP_DESKTOP_RUNTIME=win-x64

# Existing Web Deploy endpoint and destination.
MAP_WEB_DEPLOY_URL=your_value_here
MAP_WEB_DEPLOY_DEST=your_value_here
MAP_WEB_DEPLOY_USER=your_value_here
MAP_WEB_DEPLOY_PASSWORD=your_value_here
