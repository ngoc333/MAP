# MAP Deploy Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# MAP deployment root (UNC or local path). Desktop files deploy to its desktop subdirectory.
MAP_DESKTOP_DEPLOY_PATH=your_value_here

# Desktop self-contained publish runtime. Defaults to win-x64 when omitted.
MAP_DESKTOP_RUNTIME=win-x64

# Web Deploy endpoint URL used by msdeploy.exe.
MAP_WEB_DEPLOY_URL=your_value_here

# Web Deploy destination, normally the configured IIS site/application name.
MAP_WEB_DEPLOY_DEST=your_value_here

# Web Deploy account and password. These credentials are never printed.
MAP_WEB_DEPLOY_USER=your_value_here
MAP_WEB_DEPLOY_PASSWORD=your_value_here

# IIS server and the only application pool stopped/started for a release.
MAP_WEB_IIS_SERVER=your_value_here
MAP_WEB_IIS_APP_POOL=your_value_here

# Optional WinRM credentials for IIS control. Leave both blank to use the current Windows identity.
# When one is supplied, both values are required. These may differ from Web Deploy credentials.
MAP_WEB_IIS_USER=
MAP_WEB_IIS_PASSWORD=
