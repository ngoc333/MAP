# MAP Deploy Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Desktop deploy path (UNC path or local path)
MAP_DESKTOP_DEPLOY_PATH=your_value_here

# Web deploy URL (msdeploy endpoint)
MAP_WEB_DEPLOY_URL=your_value_here

# Web deploy destination (IIS site name)
MAP_WEB_DEPLOY_DEST=your_value_here

# Web deploy username
MAP_WEB_DEPLOY_USER=your_value_here

# Web deploy password
MAP_WEB_DEPLOY_PASSWORD=your_value_here
