<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MAP.H.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\MAP.C.Contract\MAP.C.Contract.csproj" />
    <ProjectReference Include="..\Core\MAP.C.Runtime\MAP.C.Runtime.csproj" />
    <ProjectReference Include="..\Core\MAP.C.UI\MAP.C.UI.csproj" />
    <ProjectReference Include="..\Core\MAP.C.Wpf\MAP.C.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Shared\Config\page.json" Link="page.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Shared\Config\db-api.json" Link="db-api.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Shared\Scripts\app-log.js" Link="js\app-log.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Module discovery: all module projects under Modules/ -->
  <ItemGroup>
    <ModuleProject Include="$(MSBuildProjectDirectory)\..\Modules\*\*.csproj" />
  </ItemGroup>

  <Target Name="BuildModules" BeforeTargets="Build;Publish">
    <MSBuild Projects="@(ModuleProject)"
             Targets="Build;GetTargetPath"
             Properties="Configuration=$(Configuration)"
             BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="_ModuleAssembly" />
    </MSBuild>
  </Target>

  <Target Name="CopyModulesToBuildOutput"
          AfterTargets="Build"
          DependsOnTargets="BuildModules">
    <PropertyGroup>
      <_ModulesOut>$(OutputPath)modules\</_ModulesOut>
    </PropertyGroup>
    <Copy SourceFiles="@(_ModuleAssembly)"
          DestinationFolder="$(_ModulesOut)" />
  </Target>

  <Target Name="CopyModulesToPublishOutput"
          AfterTargets="Publish"
          DependsOnTargets="BuildModules">
    <PropertyGroup>
      <_ModulesOut>$(PublishDir)modules\</_ModulesOut>
    </PropertyGroup>
    <Copy SourceFiles="@(_ModuleAssembly)"
          DestinationFolder="$(_ModulesOut)" />
  </Target>

  <Target Name="EnsureTailwindCli" BeforeTargets="BuildTailwindCss">
    <PropertyGroup>
      <TailwindExe>$(MSBuildProjectDirectory)\..\tools\tailwindcss.exe</TailwindExe>
      <TailwindUrl>https://github.com/tailwindlabs/tailwindcss/releases/download/v3.4.17/tailwindcss-windows-x64.exe</TailwindUrl>
    </PropertyGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\tools" Condition="!Exists('$(MSBuildProjectDirectory)\..\tools')" />
    <Exec Command="powershell -NoProfile -Command &quot;Invoke-WebRequest -Uri '$(TailwindUrl)' -OutFile '$(TailwindExe)' -UseBasicParsing&quot;" Condition="!Exists('$(TailwindExe)')" />
  </Target>

  <Target Name="BuildTailwindCss" BeforeTargets="BeforeBuild" DependsOnTargets="EnsureTailwindCli">
    <MakeDir Directories="$(OutputPath)css" />
    <Exec Command="$(TailwindExe) -i ..\Shared\Styles\tailwind-input.css -c ..\Shared\Styles\tailwind.config.js -o $(OutputPath)css\tailwind.css --minify" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="CopyTailwindCssToPublishOutput" AfterTargets="Publish" DependsOnTargets="BuildTailwindCss">
    <MakeDir Directories="$(PublishDir)css" />
    <Copy SourceFiles="$(OutputPath)css\tailwind.css" DestinationFolder="$(PublishDir)css" SkipUnchangedFiles="true" />
  </Target>

  <!-- Flatten wwwroot for BlazorWebView -->
  <Target Name="FlattenWwwrootForPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WwwrootFiles Include="$(PublishDir)wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WwwrootFiles)"
          DestinationFiles="@(_WwwrootFiles -> '$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          Condition="'@(_WwwrootFiles)' != ''"
          SkipUnchangedFiles="true" />
    <RemoveDir Directories="$(PublishDir)wwwroot" ContinueOnError="true" />
  </Target>

</Project>
