<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MAP.H.Desktop</RootNamespace>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\MAP.C.Wpf\MAP.C.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="wwwroot\css\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="wwwroot\js\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="wwwroot\fonts\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Shared\Config\page.json" Link="page.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Shared\Config\db-api.json" Link="db-api.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Shared\Scripts\app-log.js" Link="wwwroot\js\app-log.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Shared\Fonts\Inter\*.woff2" Link="wwwroot\fonts\inter\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Shared\Styles\tailwind.css" Link="wwwroot\css\tailwind.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Module discovery: all module projects under Modules/ -->
  <ItemGroup>
    <ModuleProject Include="$(MSBuildProjectDirectory)\..\Modules\*\*.csproj" />
  </ItemGroup>

  <Target Name="BuildModules" BeforeTargets="Build;Publish">
    <MSBuild Projects="@(ModuleProject)"
             Targets="Build;GetTargetPath"
             Properties="Configuration=$(Configuration)"
             BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="_ModuleAssembly" />
    </MSBuild>
  </Target>

  <Target Name="CopyModulesToBuildOutput"
          AfterTargets="Build"
          DependsOnTargets="BuildModules">
    <PropertyGroup>
      <_ModulesOut>$(OutputPath)modules\</_ModulesOut>
    </PropertyGroup>
    <Copy SourceFiles="@(_ModuleAssembly)"
          DestinationFolder="$(_ModulesOut)" />
    <!-- Copy PDB files for Debug builds -->
    <Copy SourceFiles="@(_ModuleAssembly->'%(RootDir)%(Directory)%(Filename).pdb')"
          DestinationFolder="$(_ModulesOut)"
          Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')" />
  </Target>

  <Target Name="CopyModulesToPublishOutput"
          AfterTargets="Publish"
          DependsOnTargets="BuildModules">
    <PropertyGroup>
      <_ModulesOut>$(PublishDir)modules\</_ModulesOut>
    </PropertyGroup>
    <Copy SourceFiles="@(_ModuleAssembly)"
          DestinationFolder="$(_ModulesOut)" />
  </Target>



</Project>
