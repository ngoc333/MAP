<Router AppAssembly="@typeof(DesktopApp).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MAP.C.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not Found</PageTitle>
        <LayoutView Layout="@typeof(MAP.C.Components.Layout.MainLayout)">
            <p>Sorry, the content you are looking for does not exist.</p>
        </LayoutView>
    </NotFound>
</Router>
