<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Radzen.Blazor" Version="11.1.7" />
  </ItemGroup>

  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="DSF.WASM.Home.dll" />
    <BlazorWebAssemblyLazyLoad Include="DSF.WASM.Products.dll" />
    <BlazorWebAssemblyLazyLoad Include="DSF.WASM.Customers.dll" />
    <BlazorWebAssemblyLazyLoad Include="DSF.WASM.Reports.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DSF.WASM.Shared\DSF.WASM.Shared.csproj" />
  </ItemGroup>

  <Target Name="BuildAndReferencePageProjects" BeforeTargets="ResolveAssemblyReferences">
    <MSBuild Projects="..\Pages\DSF.WASM.Home\DSF.WASM.Home.csproj;..\Pages\DSF.WASM.Products\DSF.WASM.Products.csproj;..\Pages\DSF.WASM.Customers\DSF.WASM.Customers.csproj;..\Pages\DSF.WASM.Reports\DSF.WASM.Reports.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />

    <ItemGroup>
      <Reference Include="DSF.WASM.Home">
        <HintPath>..\Pages\DSF.WASM.Home\bin\$(Configuration)\net10.0\DSF.WASM.Home.dll</HintPath>
      </Reference>
      <Reference Include="DSF.WASM.Products">
        <HintPath>..\Pages\DSF.WASM.Products\bin\$(Configuration)\net10.0\DSF.WASM.Products.dll</HintPath>
      </Reference>
      <Reference Include="DSF.WASM.Customers">
        <HintPath>..\Pages\DSF.WASM.Customers\bin\$(Configuration)\net10.0\DSF.WASM.Customers.dll</HintPath>
      </Reference>
      <Reference Include="DSF.WASM.Reports">
        <HintPath>..\Pages\DSF.WASM.Reports\bin\$(Configuration)\net10.0\DSF.WASM.Reports.dll</HintPath>
      </Reference>
    </ItemGroup>
  </Target>

</Project>
