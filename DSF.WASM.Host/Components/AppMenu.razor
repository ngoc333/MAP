@using DSF.WASM.Host.Models
@using DSF.WASM.Host.Services
@inject MenuService MenuService
@inject ModuleLoader ModuleLoader

<aside class="w-64 bg-white border-r border-gray-200 overflow-y-auto flex-shrink-0 pt-4">
    <RadzenPanelMenu>
        @foreach (var menu in MenuService.Menus)
        {
            <RadzenPanelMenuItem Text="@menu.Title" Icon="@menu.Icon" Expanded="@(menu.Id == "home")">
                @if (menu.Children is not null)
                {
                    @foreach (var child in menu.Children)
                    {
                        <RadzenPanelMenuItem Text="@child.Title" Icon="@child.Icon"
                            Click="@(async () => await OnMenuItemClick(child))" />
                    }
                }
                else if (menu.IsPage)
                {
                    <RadzenPanelMenuItem Text="@menu.Title" Icon="@menu.Icon"
                        Click="@(async () => await OnMenuItemClick(menu))" />
                }
            </RadzenPanelMenuItem>
        }
    </RadzenPanelMenu>
</aside>

@code {
    [Parameter] public EventCallback<Type?> OnMenuSelected { get; set; }

    protected override void OnInitialized()
    {
        MenuService.OnMenusLoaded += () => InvokeAsync(StateHasChanged);
    }

    private async Task OnMenuItemClick(MenuItem item)
    {
        if (!item.IsPage) return;

        var type = await ModuleLoader.LoadComponentAsync(item);
        await OnMenuSelected.InvokeAsync(type);
    }
}
