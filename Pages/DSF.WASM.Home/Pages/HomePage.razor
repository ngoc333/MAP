@namespace DSF.WASM.Home.Pages

<div class="p-2">
    <h2 class="text-2xl font-bold text-gray-800 mb-4">Giới thiệu</h2>

    <RadzenCard class="p-6 max-w-3xl">
        <h3 class="text-xl font-semibold text-gray-700 mb-3">Chào mừng đến với DSF WASM</h3>
        <p class="text-gray-600 mb-4">
            Đây là ứng dụng Blazor WebAssembly với kiến trúc module động. Mỗi trang là một DLL riêng biệt,
            được tải về khi bạn click vào menu.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div class="border border-blue-200 rounded-lg p-4 bg-blue-50">
                <RadzenIcon Icon="bolt" class="text-2xl text-blue-500 mb-2" />
                <h4 class="font-semibold text-gray-700">Lazy Loading</h4>
                <p class="text-sm text-gray-500">Module chỉ được tải khi cần, giảm thời gian khởi động</p>
            </div>
            <div class="border border-green-200 rounded-lg p-4 bg-green-50">
                <RadzenIcon Icon="extension" class="text-2xl text-green-500 mb-2" />
                <h4 class="font-semibold text-gray-700">Module độc lập</h4>
                <p class="text-sm text-gray-500">Mỗi module là một Razor Class Library riêng biệt</p>
            </div>
            <div class="border border-purple-200 rounded-lg p-4 bg-purple-50">
                <RadzenIcon Icon="dashboard_customize" class="text-2xl text-purple-500 mb-2" />
                <h4 class="font-semibold text-gray-700">Radzen Components</h4>
                <p class="text-sm text-gray-500">Giao diện sử dụng bộ components Radzen Blazor</p>
            </div>
            <div class="border border-orange-200 rounded-lg p-4 bg-orange-50">
                <RadzenIcon Icon="palette" class="text-2xl text-orange-500 mb-2" />
                <h4 class="font-semibold text-gray-700">TailwindCSS</h4>
                <p class="text-sm text-gray-500">Layout styling với TailwindCSS utility classes</p>
            </div>
        </div>
    </RadzenCard>
</div>
