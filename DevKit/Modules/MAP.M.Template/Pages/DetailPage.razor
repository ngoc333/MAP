@inherits BasePage
@namespace MAP.M.Template.Pages

<div class="p-4">
    <h2>@Lang.T("TemplateDetail.Title")</h2>
    <ApiSection Title="Parameters and Back navigation">
        <p>PageId: @PageId | CanBack: @Navigator.CanBack</p>
        <p>CustomerId (int): @_customerId | Count converted from string: @_count | Status enum: @_status</p>
        <p>Optional missing value: @(GetParameter<string>("Missing") ?? "null")</p>
        <p>PageParameters: @(_parametersText)</p>
        <ActionRow>
            <RadzenButton Text="Require invalid parameter safely" ButtonStyle="ButtonStyle.Warning" Click="TestRequiredAsync" />
            <RadzenButton Text="Confirm" Click="ConfirmDeleteAsync" />
            <RadzenButton Text="Back" Click="() => Navigator.BackAsync()" Disabled="@(!Navigator.CanBack)" />
        </ActionRow>
        <ResultPanel Value="@_result" />
    </ApiSection>
</div>

@code {
    private int _customerId;
    private int _count;
    private DemoStatus? _status;
    private string _parametersText = "null";
    private string? _result;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _customerId = GetParameter<int>("CustomerId");
        _count = GetParameter<int>("Count");
        _status = GetParameter<DemoStatus>("Status");
        _parametersText = PageParameters is null ? "null" : "captured for this page instance";
    }

    private async Task ConfirmDeleteAsync()
    {
        if (await ConfirmAsync($"Continue with customer {_customerId}?"))
            NotifyWarning("Confirmed.");
    }

    private Task TestRequiredAsync()
    {
        try { _ = RequireParameter<Guid>("MissingRequired"); }
        catch (InvalidOperationException exception) { _result = exception.Message; }
        return Task.CompletedTask;
    }

    private enum DemoStatus { Active, Inactive }
}
