@inherits BasePage
@namespace MAP.M.Template.Pages

<div class="p-4">
    <h2>@Lang.T("TemplateDetail.Title")</h2>
    <p>@Lang.T("TemplateDetail.Description")</p>

    <ApiSection Title="@Lang.T("TemplateDetail.ParametersTitle")">
        <p class="text-sm text-gray-600"><code>GetParameter&lt;T&gt;</code>: @Lang.T("TemplateDetail.GetParameterDescription")</p>
        <p class="text-sm text-gray-600"><code>RequireParameter&lt;T&gt;</code>: @Lang.T("TemplateDetail.RequireParameterDescription")</p>
        <p>PageId: @PageId | CanBack: @Navigator.CanBack</p>
        <p>CustomerId: @_customerId</p>
        <p>Status: @_status</p>
        <p>Optional value: @(GetParameter<string>("OptionalNote") ?? "null")</p>
        <p><code>RequireParameter&lt;string&gt;("Status")</code>: @_requiredStatus</p>
        <ActionRow>
            <RadzenButton Text="ConfirmAsync" Click="ConfirmAsync" />
            <RadzenButton Text="Back" Disabled="@(!Navigator.CanBack)" Click="BackAsync" />
        </ActionRow>
        <ResultPanel Value="@_result" />
    </ApiSection>
</div>

@code {
    private int _customerId;
    private string? _status;
    private string? _requiredStatus;
    private string? _result;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _customerId = GetParameter<int>("CustomerId");
        _status = GetParameter<string>("Status");
        _requiredStatus = _status is null
            ? "Status was not supplied."
            : RequireParameter<string>("Status");
    }

    private async Task ConfirmAsync()
    {
        _result = await base.ConfirmAsync($"Continue with customer {_customerId}?")
            ? "Confirmed"
            : "Cancelled";
    }

    private Task BackAsync() => Navigator.BackAsync();
}
