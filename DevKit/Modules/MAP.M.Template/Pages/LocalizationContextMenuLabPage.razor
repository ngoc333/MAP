@inherits BasePage
@namespace MAP.M.Template.Pages
@inject IModuleLoader ModuleLoader
@inject IClientContextService ClientContext

<div class="p-4">
    <h2>@Lang.T("TemplateLocalization.Title")</h2>

    <ApiSection Title="@Lang.T("TemplateLocalization.LocalizationTitle")" Note="@Lang.T("TemplateLocalization.LocalizationDescription")">
        <p><code>Lang.T("TemplateHome.Title")</code>: @Lang.T("TemplateHome.Title")</p>
        <p>CurrentLanguage: @Lang.CurrentLanguage</p>
        <p>AvailableLanguages: @string.Join(", ", Lang.AvailableLanguages.Select(language => language.Code))</p>
        <ActionRow>
            <RadzenButton Text="Tiếng Việt" Click="SetVietnamese" />
            <RadzenButton Text="English" Click="SetEnglish" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateLocalization.ContextTitle")" Note="@Lang.T("TemplateLocalization.ContextDescription")">
        <p>ProgramId: @ClientContext.Current.ProgramId</p>
        <p>UserName: @ClientContext.Current.UserName | IpAddress: @ClientContext.Current.IpAddress</p>
        <p>LocalPath: @ClientContext.Current.LocalPath</p>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateLocalization.MenuTitle")" Note="@Lang.T("TemplateLocalization.MenuDescription")">
        <p>StartPageId: @MenuService.StartPageId | DbName: @MenuService.DbName</p>
        <label>
            Menu/Page ID
            <input @bind="_menuId" />
        </label>
        <ActionRow>
            <RadzenButton Text="FindById" Click="FindMenuItem" />
            <RadzenButton Text="Load selected component" Disabled="@(_selectedItem is null)" Click="LoadComponentAsync" />
        </ActionRow>
        @if (_selectedItem is not null)
        {
            <p>ID: @_selectedItem.Id | Title: @MenuTitle.Get(_selectedItem, Lang.CurrentLanguage)</p>
            <p>Assembly: @_selectedItem.Assembly | Component: @_selectedItem.Component</p>
        }
        <p>Menus:</p>
        <ul>
            @foreach (var item in MenuService.Menus)
            {
                <MenuNode Item="item" />
            }
        </ul>
        <ResultPanel Value="@_result" />
    </ApiSection>
</div>

@code {
    private string _menuId = "template-home";
    private MenuItem? _selectedItem;
    private string? _result;

    private void SetVietnamese() => Lang.SetLanguage("vi");

    private void SetEnglish() => Lang.SetLanguage("en");

    private void FindMenuItem()
    {
        _selectedItem = MenuService.FindById(_menuId);
        _result = _selectedItem is null
            ? $"No menu item was found for '{_menuId}'."
            : "Menu item found.";
    }

    private async Task LoadComponentAsync()
    {
        var componentType = await ModuleLoader.LoadComponentAsync(_selectedItem!);
        _result = $"Resolved type: {componentType.FullName}";
    }
}
