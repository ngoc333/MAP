@inherits BasePage
@namespace MAP.M.Template.Pages

<div class="p-4">
    <h2>@Lang.T("TemplateHome.Title")</h2>
    <p>@Lang.T("TemplateHome.Description")</p>

    <ApiSection Title="@Lang.T("TemplateHome.RuntimeTitle")" Note="@Lang.T("TemplateHome.RuntimeDescription")">
        <p>PageId: @PageId</p>
        <p>UserName: @UserName | IpAddress: @IpAddress</p>
        <p>DbName: @MenuService.DbName | Language: @Lang.CurrentLanguage | Session: @AppSession.Id</p>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateHome.NotificationsTitle")" Note="@Lang.T("TemplateHome.NotificationsDescription")">
        <ActionRow>
            <RadzenButton Text="NotifySuccess" ButtonStyle="ButtonStyle.Success" Click="ShowSuccess" />
            <RadzenButton Text="NotifyWarning" ButtonStyle="ButtonStyle.Warning" Click="ShowWarning" />
            <RadzenButton Text="NotifyError" ButtonStyle="ButtonStyle.Danger" Click="ShowError" />
            <RadzenButton Text="ConfirmAsync" Click="ConfirmAsync" />
        </ActionRow>
        <ResultPanel Value="@_result" />
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateHome.FeaturesTitle")" Note="@Lang.T("TemplateHome.FeaturesDescription")">
        <div class="grid gap-3 md:grid-cols-2">
            @foreach (var lab in Labs)
            {
                <RadzenCard class="p-3">
                    <h3 class="m-0 text-lg font-semibold">@Lang.T($"{lab.Key}.Title")</h3>
                    <p class="mt-2 text-sm text-gray-600">@Lang.T($"{lab.Key}.Description")</p>
                    <RadzenButton Text="@Lang.T("TemplateCommon.Open")" Click="() => OpenPageAsync(lab.PageId)" />
                </RadzenCard>
            }
        </div>
    </ApiSection>
</div>

@code {
    private static readonly (string PageId, string Key)[] Labs =
    [
        ("template-detail", "TemplateHome.Features.Parameters"),
        ("template-navigation", "TemplateHome.Features.Navigation"),
        ("template-header-ui", "TemplateHome.Features.HeaderUi"),
        ("template-localization-context-menu", "TemplateHome.Features.Localization"),
        ("template-database", "TemplateHome.Features.Database"),
        ("template-config-platform", "TemplateHome.Features.Config"),
        ("template-logging-error", "TemplateHome.Features.Logging"),
        ("template-lifecycle", "TemplateHome.Features.Lifecycle"),
        ("template-utilities", "TemplateHome.Features.Utilities")
    ];

    private string? _result;

    private void ShowSuccess() => NotifySuccess(Lang.T("TemplateHome.Success"));

    private void ShowWarning() => NotifyWarning("This is a warning notification.");

    private void ShowError() => NotifyError("This is an error notification.");

    private async Task ConfirmAsync()
    {
        _result = await base.ConfirmAsync("Run the confirmation dialog?")
            ? "Confirmed"
            : "Cancelled";
    }
}
