@inherits BasePage
@namespace MAP.M.Template.Pages

<div class="p-4">
    <h2>@Lang.T("TemplateNavigation.StepCTitle")</h2>
    <p>@Lang.T("TemplateNavigation.StepCNote")</p>
    <p>@Lang.T("TemplateNavigation.ReceivedFrom"): @(GetParameter<string>("From"))</p>
    <ActionRow><RadzenButton Text="@Lang.T("TemplateCommon.Back")" Click="BackAsync" /></ActionRow>
</div>

@code {
    private Task BackAsync() => Navigator.BackAsync();
}
