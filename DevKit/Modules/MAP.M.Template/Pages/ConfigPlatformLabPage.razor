@inherits BasePage
@namespace MAP.M.Template.Pages
@inject IAppConfigService ConfigService
@inject IPlatformCapabilities Platform

<div class="p-4"><h2>Configuration and platform lab <small>Advanced / guarded side effect</small></h2>
<ApiSection Title="Read-only platform information"><p>Config exists: @ConfigService.Exists</p><p>@JsonSerializer.Serialize(ConfigService.GetSystemInfo())</p><p>Displays: @JsonSerializer.Serialize(ConfigService.GetDisplays())</p><p>Capabilities — Fullscreen: @Platform.SupportsFullscreen; Hide taskbar: @Platform.SupportsHideTaskbar; Display selection: @Platform.SupportsDisplaySelection</p></ApiSection>
<ApiSection Title="Editable AppConfig" Note="Draft is cloned; it is not the mutable service Current. Save is manual and confirmed.">@if (_draft is not null) { <label>Program ID <input @bind="_draft.ProgramId" /></label><label class="ml-2">Default language <input @bind="_draft.DefaultLanguage" /></label><br/><label><input type="checkbox" @bind="_draft.ShowMenu" /> Show menu</label><label class="ml-2"><input type="checkbox" @bind="_draft.Fullscreen" disabled="@(!Platform.SupportsFullscreen)" /> Fullscreen</label><label class="ml-2"><input type="checkbox" @bind="_draft.HideTaskbar" disabled="@(!Platform.SupportsHideTaskbar)" /> Hide taskbar</label><br/><p>Before: @_before</p><p>Draft: @JsonSerializer.Serialize(_draft)</p><RadzenButton Text="Save after confirmation" Click="SaveAsync" /> } else { <p>No current configuration is available.</p> }</ApiSection>
<ApiSection Title="Danger zone" Tier="Destructive"><p>Restart is separate from Save. Desktop starts a new process then exits; Web reloads.</p><RadzenButton Text="Restart after confirmation" ButtonStyle="ButtonStyle.Danger" Click="RestartAsync" /></ApiSection><ResultPanel Value="@_result" /></div>
@code { private AppConfig? _draft; private string _before=""; private string? _result; protected override void OnInitialized(){base.OnInitialized(); if(ConfigService.Current is { } current){_draft=Clone(current);_before=JsonSerializer.Serialize(current);}}
 private async Task SaveAsync(){if(_draft is not null && await ConfirmAsync("Save this configuration draft?")){await ConfigService.SaveAsync(_draft);_result="Saved manually. Live UI visibility is controlled separately by IUiStateService.";}} private async Task RestartAsync(){if(await ConfirmAsync("Restart the application now?")){if(await ConfirmAsync("This ends the current session. Continue?")) ConfigService.RestartApp();}} private static AppConfig Clone(AppConfig source)=>new(){ProgramId=source.ProgramId,Fullscreen=source.Fullscreen,HideTaskbar=source.HideTaskbar,DisplayIndex=source.DisplayIndex,ShowMenu=source.ShowMenu,DefaultLanguage=source.DefaultLanguage,MenuSource=source.MenuSource,ShowModuleErrorNotification=source.ShowModuleErrorNotification,ModuleErrorMessage=source.ModuleErrorMessage}; }
