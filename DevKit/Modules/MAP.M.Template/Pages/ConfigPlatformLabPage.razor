@inherits BasePage
@namespace MAP.M.Template.Pages
@inject IAppConfigService ConfigService
@inject IPlatformCapabilities Platform

<div class="p-4">
    <h2>@Lang.T("TemplateConfig.Title")</h2>

    <ApiSection Title="@Lang.T("TemplateConfig.PlatformTitle")" Tier="@Lang.T("TemplateCommon.Advanced")">
        <p>@Lang.T("TemplateConfig.ConfigExists"): @ConfigService.Exists</p>
        <p>Current: @JsonSerializer.Serialize(ConfigService.Current)</p>
        <p>@Lang.T("TemplateConfig.SystemInfo"): @JsonSerializer.Serialize(ConfigService.GetSystemInfo())</p>
        <p>@Lang.T("TemplateConfig.Displays"): @JsonSerializer.Serialize(ConfigService.GetDisplays())</p>
        <p>@Lang.T("TemplateConfig.Capabilities"): Fullscreen=@Platform.SupportsFullscreen; HideTaskbar=@Platform.SupportsHideTaskbar; DisplaySelection=@Platform.SupportsDisplaySelection</p>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateConfig.EditTitle")" Note="@Lang.T("TemplateConfig.EditNote")">
        <div class="grid gap-3 md:grid-cols-2">
            <label>ProgramId <input @bind="_draft.ProgramId" /></label>
            <label>DefaultLanguage <input @bind="_draft.DefaultLanguage" /></label>
            <label>MenuSource <input @bind="_draft.MenuSource" /></label>
            <label>DisplayIndex <input type="number" @bind="_draft.DisplayIndex" disabled="@(!Platform.SupportsDisplaySelection)" /></label>
            <label class="flex items-center gap-2"><input type="checkbox" @bind="_draft.ShowMenu" /> ShowMenu</label>
            <label class="flex items-center gap-2"><input type="checkbox" @bind="_draft.Fullscreen" disabled="@(!Platform.SupportsFullscreen)" /> Fullscreen</label>
            <label class="flex items-center gap-2"><input type="checkbox" @bind="_draft.HideTaskbar" disabled="@(!Platform.SupportsHideTaskbar)" /> HideTaskbar</label>
            <label class="flex items-center gap-2"><input type="checkbox" @bind="_draft.ShowModuleErrorNotification" /> ShowModuleErrorNotification</label>
            <label class="md:col-span-2">ModuleErrorMessage <input class="w-full" @bind="_draft.ModuleErrorMessage" /></label>
        </div>
        <p>@Lang.T("TemplateConfig.Before"): @_before</p>
        <p>@Lang.T("TemplateConfig.Draft"): @JsonSerializer.Serialize(_draft)</p>
        <p>@Lang.T("TemplateConfig.After"): @_after</p>
        <ActionRow><RadzenButton Text="@Lang.T("TemplateCommon.Save")" Click="SaveAsync" /></ActionRow>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateConfig.RestartTitle")" Tier="@Lang.T("TemplateCommon.Destructive")">
        <p>@Lang.T("TemplateConfig.RestartNote")</p>
        <ActionRow><RadzenButton Text="@Lang.T("TemplateConfig.Restart")" ButtonStyle="ButtonStyle.Danger" Click="RestartAsync" /></ActionRow>
    </ApiSection>
    <ResultPanel Value="@_result" />
</div>

@code {
    private AppConfig _draft = new();
    private string _before = "";
    private string _after = "";
    private string? _result;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        var source = ConfigService.Current ?? new AppConfig();
        _draft = Clone(source);
        _before = JsonSerializer.Serialize(source);
    }

    private async Task SaveAsync()
    {
        if (!await ConfirmAsync(Lang.T("TemplateConfig.SaveConfirm")))
            return;

        await ConfigService.SaveAsync(_draft);
        _after = JsonSerializer.Serialize(ConfigService.Current ?? _draft);
        _result = Lang.T("TemplateConfig.Saved");
    }

    private async Task RestartAsync()
    {
        if (await ConfirmAsync(Lang.T("TemplateConfig.RestartConfirmOne")))
            ConfigService.RestartApp();
    }

    private static AppConfig Clone(AppConfig source) => new()
    {
        ProgramId = source.ProgramId,
        Fullscreen = source.Fullscreen,
        HideTaskbar = source.HideTaskbar,
        DisplayIndex = source.DisplayIndex,
        ShowMenu = source.ShowMenu,
        DefaultLanguage = source.DefaultLanguage,
        MenuSource = source.MenuSource,
        ShowModuleErrorNotification = source.ShowModuleErrorNotification,
        ModuleErrorMessage = source.ModuleErrorMessage
    };
}
