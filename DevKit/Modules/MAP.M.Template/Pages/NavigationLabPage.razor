@inherits BasePage
@namespace MAP.M.Template.Pages

<div class="p-4">
    <h2>@Lang.T("TemplateNavigation.Title")</h2>
    <p>Use <code>OpenPageAsync</code> for normal module navigation. It reports navigation errors through the module error helper.</p>

    <ApiSection Title="Open a page">
        <ActionRow>
            <RadzenButton Text="Open detail" Click="OpenDetailAsync" />
            <RadzenButton Text="Open detail with parameters" Click="OpenDetailWithParametersAsync" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="History" Note="A → B (pushHistory=true) → C (pushHistory=false) → Back returns to A.">
        <p>Current page: @Navigator.Current?.PageId | CanBack: @Navigator.CanBack</p>
        <ActionRow>
            <RadzenButton Text="Start flow at B" Click="OpenBAsync" />
            <RadzenButton Text="Back" Disabled="@(!Navigator.CanBack)" Click="BackAsync" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="Root navigation" Note="OpenRootAsync clears the Back history before opening the page.">
        <ActionRow>
            <RadzenButton Text="Open navigation as root" Click="OpenRootAsync" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="Safe failure">
        <p>Try an unknown page to see the standard navigation error notification.</p>
        <ActionRow>
            <RadzenButton Text="Open does-not-exist" ButtonStyle="ButtonStyle.Warning" Click="OpenUnknownPageAsync" />
        </ActionRow>
    </ApiSection>
</div>

@code {
    private Task OpenDetailAsync() => OpenPageAsync("template-detail");

    private Task OpenDetailWithParametersAsync() => OpenPageAsync(
        "template-detail",
        new
        {
            CustomerId = 42,
            Status = "Active"
        });

    private Task OpenBAsync() => Navigator.OpenAsync(
        "template-navigation-b",
        new { From = PageId },
        pushHistory: true);

    private Task BackAsync() => Navigator.BackAsync();

    private Task OpenRootAsync() => Navigator.OpenRootAsync("template-navigation");

    private Task OpenUnknownPageAsync() => OpenPageAsync("does-not-exist");
}
