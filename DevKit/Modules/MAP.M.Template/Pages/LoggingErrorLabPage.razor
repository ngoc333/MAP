@inherits BasePage
@namespace MAP.M.Template.Pages
@inject ILogStore LogStore
@inject DialogService Dialogs

<div class="p-4">
    <h2>@Lang.T("TemplateLogging.Title")</h2>

    <ApiSection Title="@Lang.T("TemplateLogging.LogStoreTitle")" Note="@Lang.T("TemplateLogging.LogStoreDescription")">
        <ActionRow>
            <RadzenButton Text="WriteAsync" Click="WriteAsync" />
            <RadzenButton Text="GetDaysAsync" Click="GetDaysAsync" />
            <RadzenButton Text="GetAsync" Click="GetAsync" />
            <RadzenButton Text="ClearAsync" ButtonStyle="ButtonStyle.Warning" Click="ClearAsync" />
        </ActionRow>
        <p>Days: @_days</p>
        <p>Sample LogEntry: @_sampleEntry</p>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateLogging.ErrorTitle")" Note="@Lang.T("TemplateLogging.ErrorDescription")">
        <ActionRow>
            <RadzenButton Text="Create error ID" Click="CreateErrorId" />
            <RadzenButton Text="ErrorNotifier.Notify" Click="NotifyError" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateLogging.FaultTitle")" Tier="@Lang.T("TemplateCommon.Advanced")" Note="@Lang.T("TemplateLogging.FaultDescription")">
        <ModuleErrorBoundary OnFaulted="ProbeFaulted">
            <ChildContent>
                <FaultProbe />
            </ChildContent>
            <ErrorContent Context="error">
                <p>Probe fault captured: @error.Message</p>
            </ErrorContent>
        </ModuleErrorBoundary>
    </ApiSection>

    <ResultPanel Value="@_result" />
</div>

@code {
    private static readonly DateOnly SandboxDay = new(2099, 12, 31);
    private string? _days;
    private string? _errorId;
    private string? _result;
    private string? _sampleEntry;

    private async Task WriteAsync()
    {
        var entry = new LogEntry
        {
            Timestamp = new DateTimeOffset(2099, 12, 31, 12, 0, 0, TimeSpan.Zero),
            Level = "Information",
            Category = "MAP.M.Template.Sandbox",
            Message = "Template sandbox entry",
            SessionId = AppSession.Id
        };

        await LogStore.WriteAsync(entry, PageCancellationToken);
        _sampleEntry = JsonSerializer.Serialize(entry);
        _result = "Sandbox entry written.";
    }

    private async Task GetDaysAsync()
    {
        _days = string.Join(", ", await LogStore.GetDaysAsync(PageCancellationToken));
        _result = "Sandbox days loaded.";
    }

    private async Task GetAsync()
    {
        var entries = await LogStore.GetAsync(SandboxDay, PageCancellationToken);
        _result = JsonSerializer.Serialize(entries);
    }

    private async Task ClearAsync()
    {
        if (await Dialogs.Confirm("Clear only 2099-12-31 sandbox logs?") != true)
            return;

        await LogStore.ClearAsync(SandboxDay, PageCancellationToken);
        _result = "Sandbox day cleared.";
    }

    private void CreateErrorId()
    {
        var exception = new InvalidOperationException("Template error example");
        _errorId = ModuleErrorId.GetOrCreate(exception);
        _result = $"Created: {ModuleErrorId.Create()}; correlated: {_errorId}";
    }

    private void NotifyError()
    {
        _errorId ??= ModuleErrorId.Create();
        ErrorNotifier.Notify(_errorId);
        _result = $"Notification requested for {_errorId}.";
    }

    private void ProbeFaulted()
    {
        _result = "Nested ModuleErrorBoundary captured the opt-in fault.";
    }
}
