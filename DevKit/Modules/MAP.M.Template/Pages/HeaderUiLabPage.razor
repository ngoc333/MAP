@inherits BasePage
@namespace MAP.M.Template.Pages
@inject IUiStateService UiState

<div class="p-4">
    <h2>@Lang.T("TemplateHeaderUi.Title")</h2>

    <ApiSection Title="@Lang.T("TemplateHeaderUi.UiStateTitle")" Tier="@Lang.T("TemplateCommon.Advanced")" Note="@Lang.T("TemplateHeaderUi.UiStateNote")">
        <p>ShowMenu: @UiState.ShowMenu | ShowHeader: @UiState.ShowHeader | Changed: @_uiChanges</p>
        <ActionRow>
            <RadzenButton Text="ToggleMenu()" Click="UiState.ToggleMenu" />
            <RadzenButton Text="ToggleHeader()" Click="UiState.ToggleHeader" />
            <RadzenButton Text="SetMenu(true)" Click="() => UiState.SetMenu(true)" />
            <RadzenButton Text="SetMenu(false)" Click="() => UiState.SetMenu(false)" />
            <RadzenButton Text="SetHeader(true)" Click="() => UiState.SetHeader(true)" />
            <RadzenButton Text="SetHeader(false)" Click="() => UiState.SetHeader(false)" />
            <RadzenButton Text="@Lang.T("TemplateCommon.Restore")" Click="Restore" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateHeaderUi.HeaderTitle")" Note="@Lang.T("TemplateHeaderUi.HostGapNote")">
        <p>Active: @Header.Active?.PageId | Kind: @Header.Active?.Kind | ShowBack: @Header.Active?.ShowBack | Changes: @_headerChanges</p>
        <ActionRow>
            <RadzenButton Text="HeaderKind.Default" Click="SetDefault" />
            <RadzenButton Text="HeaderKind.Compact" Click="SetCompact" />
            <RadzenButton Text="Toggle ShowBack" Click="ToggleShowBack" />
            <RadzenButton Text="Toggle HeaderContent" Click="ToggleHeaderContent" />
            <RadzenButton Text="Header.Set(...)" Click="SetHeaderDirectly" />
            <RadzenButton Text="Header.Clear()" Click="Header.Clear" />
            <RadzenButton Text="RefreshHeader()" Click="RefreshHeader" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateHeaderUi.RadzenTitle")" Tier="@Lang.T("TemplateCommon.Advanced")">
        <ActionRow>
            <RadzenButton Text="NotificationService.Notify" Click="DirectNotification" />
            <RadzenButton Text="DialogService.Alert" Click="DirectAlertAsync" />
        </ActionRow>
    </ApiSection>
</div>

@code {
    private bool _initialMenu;
    private bool _initialHeader;
    private int _uiChanges;
    private int _headerChanges;
    private HeaderKind _headerKind = HeaderKind.Default;
    private bool _showBack = true;
    private bool _showCustomContent;

    protected override string? HeaderTitleKey => "TemplateHeaderUi.Title";
    protected override HeaderKind HeaderKind => _headerKind;
    protected override bool ShowBack => _showBack;
    protected override RenderFragment? HeaderContent => _showCustomContent
        ? builder => builder.AddContent(0, "Template custom header content")
        : null;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _initialMenu = UiState.ShowMenu;
        _initialHeader = UiState.ShowHeader;
        UiState.Changed += UiChanged;
        Header.Changed += HeaderChanged;
    }

    private void UiChanged()
    {
        _uiChanges++;
        InvokeAsync(StateHasChanged);
    }

    private void HeaderChanged()
    {
        _headerChanges++;
        InvokeAsync(StateHasChanged);
    }

    private void Restore()
    {
        UiState.SetMenu(_initialMenu);
        UiState.SetHeader(_initialHeader);
    }

    private void SetDefault()
    {
        _headerKind = HeaderKind.Default;
        RefreshHeader();
    }

    private void SetCompact()
    {
        _headerKind = HeaderKind.Compact;
        RefreshHeader();
    }

    private void ToggleShowBack()
    {
        _showBack = !_showBack;
        RefreshHeader();
    }

    private void ToggleHeaderContent()
    {
        _showCustomContent = !_showCustomContent;
        RefreshHeader();
    }

    private void SetHeaderDirectly() => Header.Set(new PageHeader(
        PageId,
        HeaderKind.Compact,
        "TemplateHeaderUi.Title",
        HeaderContent,
        _showBack));

    private void DirectNotification() => Notifications.Notify(new NotificationMessage
    {
        Severity = NotificationSeverity.Info,
        Detail = "Direct NotificationService call"
    });

    private Task DirectAlertAsync() => Dialogs.Alert("Direct DialogService alert");

    protected override ValueTask DisposePageAsync()
    {
        Restore();
        UiState.Changed -= UiChanged;
        Header.Changed -= HeaderChanged;
        return ValueTask.CompletedTask;
    }
}
