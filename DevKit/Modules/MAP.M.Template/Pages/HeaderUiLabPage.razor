@inherits BasePage
@namespace MAP.M.Template.Pages
@inject IUiStateService UiState

<div class="p-4">
    <h2>@Lang.T("TemplateHeaderUi.Title")</h2>

    <ApiSection Title="@Lang.T("TemplateHeaderUi.HeaderTitle")" Note="@Lang.T("TemplateHeaderUi.HeaderDescription")">
        <p>HeaderTitleKey: @HeaderTitleKey | HeaderKind: @HeaderKind | ShowBack: @ShowBack</p>
        <p>HeaderContent: @(_showCustomContent ? "Custom content is active" : "No custom content")</p>
        <ActionRow>
            <RadzenButton Text="Change title" Click="ChangeTitle" />
            <RadzenButton Text="Toggle HeaderContent" Click="ToggleHeaderContent" />
            <RadzenButton Text="Toggle ShowBack" Click="ToggleShowBack" />
            <RadzenButton Text="RefreshHeader()" Click="RefreshHeader" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateHeaderUi.UiTitle")" Note="@Lang.T("TemplateHeaderUi.UiDescription")">
        <p>ShowMenu: @UiState.ShowMenu | ShowHeader: @UiState.ShowHeader</p>
        <ActionRow>
            <RadzenButton Text="ToggleMenu()" Click="UiState.ToggleMenu" />
            <RadzenButton Text="ToggleHeader()" Click="UiState.ToggleHeader" />
            <RadzenButton Text="SetMenu(true)" Click="() => UiState.SetMenu(true)" />
            <RadzenButton Text="SetMenu(false)" Click="() => UiState.SetMenu(false)" />
            <RadzenButton Text="SetHeader(true)" Click="() => UiState.SetHeader(true)" />
            <RadzenButton Text="SetHeader(false)" Click="() => UiState.SetHeader(false)" />
            <RadzenButton Text="Restore" Click="Restore" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateHeaderUi.NotificationsTitle")" Note="@Lang.T("TemplateHeaderUi.NotificationsDescription")">
        <ActionRow>
            <RadzenButton Text="NotifySuccess" ButtonStyle="ButtonStyle.Success" Click="ShowSuccess" />
            <RadzenButton Text="NotifyWarning" ButtonStyle="ButtonStyle.Warning" Click="ShowWarning" />
            <RadzenButton Text="NotifyError" ButtonStyle="ButtonStyle.Danger" Click="ShowError" />
            <RadzenButton Text="ConfirmAsync" Click="ConfirmAsync" />
        </ActionRow>
        <ResultPanel Value="@_result" />
    </ApiSection>
</div>

@code {
    private bool _initialMenu;
    private bool _initialHeader;
    private bool _showBack = true;
    private bool _showCustomContent;
    private bool _useAlternateTitle;
    private string? _result;

    protected override string? HeaderTitleKey => _useAlternateTitle
        ? "TemplateHeaderUi.CustomTitle"
        : "TemplateHeaderUi.Title";

    protected override HeaderKind HeaderKind => HeaderKind.Default;

    protected override bool ShowBack => _showBack;

    protected override RenderFragment? HeaderContent => _showCustomContent
        ? builder => builder.AddContent(0, "Template custom header content")
        : null;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _initialMenu = UiState.ShowMenu;
        _initialHeader = UiState.ShowHeader;
    }

    private void ChangeTitle()
    {
        _useAlternateTitle = !_useAlternateTitle;
        RefreshHeader();
    }

    private void ToggleHeaderContent()
    {
        _showCustomContent = !_showCustomContent;
        RefreshHeader();
    }

    private void ToggleShowBack()
    {
        _showBack = !_showBack;
        RefreshHeader();
    }

    private void Restore()
    {
        UiState.SetMenu(_initialMenu);
        UiState.SetHeader(_initialHeader);
    }

    private void ShowSuccess() => NotifySuccess("Header change saved.");

    private void ShowWarning() => NotifyWarning("This is a warning notification.");

    private void ShowError() => NotifyError("This is an error notification.");

    private async Task ConfirmAsync()
    {
        _result = await base.ConfirmAsync("Apply this header example?")
            ? "Confirmed"
            : "Cancelled";
    }

    protected override ValueTask DisposePageAsync()
    {
        Restore();
        return ValueTask.CompletedTask;
    }
}
