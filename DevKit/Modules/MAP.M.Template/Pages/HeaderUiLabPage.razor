@inherits BasePage
@namespace MAP.M.Template.Pages
@inject IUiStateService UiState
@inject IPageHeaderState Header
@inject DialogService Dialogs
@inject NotificationService Notifications

<div class="p-4">
    <h2>@Lang.T("TemplateHeaderUi.Title")</h2>

    <ApiSection Title="@Lang.T("TemplateHeaderUi.HeaderTitle")" Note="@Lang.T("TemplateHeaderUi.HeaderDescription")">
        <p>TitleKey: @CurrentHeaderTitleKey | Kind: @CurrentHeaderKind | ShowBack: @CurrentShowBack</p>
        <p>Content: @(_showCustomContent ? "Custom content is active" : "No custom content")</p>
        <ActionRow>
            <RadzenButton Text="Change title" Click="ChangeTitle" />
            <RadzenButton Text="Toggle content" Click="ToggleHeaderContent" />
            <RadzenButton Text="Toggle back" Click="ToggleShowBack" />
            <RadzenButton Text="Header.Set(...)" Click="RefreshHeader" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateHeaderUi.UiTitle")" Note="@Lang.T("TemplateHeaderUi.UiDescription")">
        <p>ShowMenu: @UiState.ShowMenu | ShowHeader: @UiState.ShowHeader</p>
        <ActionRow>
            <RadzenButton Text="ToggleMenu()" Click="UiState.ToggleMenu" />
            <RadzenButton Text="ToggleHeader()" Click="UiState.ToggleHeader" />
            <RadzenButton Text="SetMenu(true)" Click="() => UiState.SetMenu(true)" />
            <RadzenButton Text="SetMenu(false)" Click="() => UiState.SetMenu(false)" />
            <RadzenButton Text="SetHeader(true)" Click="() => UiState.SetHeader(true)" />
            <RadzenButton Text="SetHeader(false)" Click="() => UiState.SetHeader(false)" />
            <RadzenButton Text="Restore" Click="Restore" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateHeaderUi.NotificationsTitle")" Note="@Lang.T("TemplateHeaderUi.NotificationsDescription")">
        <ActionRow>
            <RadzenButton Text="Notification success" ButtonStyle="ButtonStyle.Success" Click="ShowSuccess" />
            <RadzenButton Text="Notification warning" ButtonStyle="ButtonStyle.Warning" Click="ShowWarning" />
            <RadzenButton Text="Notification error" ButtonStyle="ButtonStyle.Danger" Click="ShowError" />
            <RadzenButton Text="Dialog confirm" Click="ConfirmAsync" />
        </ActionRow>
        <ResultPanel Value="@_result" />
    </ApiSection>
</div>

@code {
    private bool _initialMenu;
    private bool _initialHeader;
    private bool _showBack = true;
    private bool _showCustomContent;
    private bool _useAlternateTitle;
    private string? _result;

    private string CurrentHeaderTitleKey => _useAlternateTitle
        ? "TemplateHeaderUi.CustomTitle"
        : "TemplateHeaderUi.Title";

    private HeaderKind CurrentHeaderKind => HeaderKind.Default;

    private bool CurrentShowBack => _showBack;

    private RenderFragment? CurrentHeaderContent => _showCustomContent
        ? builder => builder.AddContent(0, "Template custom header content")
        : null;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _initialMenu = UiState.ShowMenu;
        _initialHeader = UiState.ShowHeader;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            RefreshHeader();
    }

    private void RefreshHeader()
    {
        Header.Set(new PageHeader(
            PageId,
            CurrentHeaderKind,
            CurrentHeaderTitleKey,
            CurrentHeaderContent,
            CurrentShowBack));
    }

    private void ChangeTitle()
    {
        _useAlternateTitle = !_useAlternateTitle;
        RefreshHeader();
    }

    private void ToggleHeaderContent()
    {
        _showCustomContent = !_showCustomContent;
        RefreshHeader();
    }

    private void ToggleShowBack()
    {
        _showBack = !_showBack;
        RefreshHeader();
    }

    private void Restore()
    {
        UiState.SetMenu(_initialMenu);
        UiState.SetHeader(_initialHeader);
    }

    private void ShowSuccess() => Notify("Header change saved.", NotificationSeverity.Success);

    private void ShowWarning() => Notify("This is a warning notification.", NotificationSeverity.Warning);

    private void ShowError() => Notify("This is an error notification.", NotificationSeverity.Error);

    private void Notify(string message, NotificationSeverity severity) =>
        Notifications.Notify(new NotificationMessage
        {
            Severity = severity,
            Detail = message
        });

    private async Task ConfirmAsync()
    {
        _result = await Dialogs.Confirm("Apply this header example?") == true
            ? "Confirmed"
            : "Cancelled";
    }

    protected override ValueTask DisposePageAsync()
    {
        Restore();
        return ValueTask.CompletedTask;
    }
}
