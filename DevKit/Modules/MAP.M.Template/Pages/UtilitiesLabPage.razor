@inherits BasePage
@namespace MAP.M.Template.Pages

<div class="p-4">
    <h2>@Lang.T("TemplateUtilities.Title")</h2>
    <p>@Lang.T("TemplateUtilities.Description")</p>

    <ApiSection Title="@Lang.T("TemplateUtilities.PageParamsTitle")" Note="@Lang.T("TemplateUtilities.PageParamsDescription")">
        <ActionRow>
            <RadzenButton Text="Run PageParams example" Click="RunPageParams" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateUtilities.DbJsonTitle")" Note="@Lang.T("TemplateUtilities.DbJsonDescription")">
        <ActionRow>
            <RadzenButton Text="Serialize an object" Click="RunDbJson" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateUtilities.MenuTitle")" Note="@Lang.T("TemplateUtilities.MenuDescription")">
        <ActionRow>
            <RadzenButton Text="Find a page" Click="RunMenuTree" />
            <RadzenButton Text="Get localized title" Click="RunMenuTitle" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="ModuleErrorId">
        <ActionRow>
            <RadzenButton Text="Create correlation ID" Click="RunModuleErrorId" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="MenuConfigValidator" Tier="Advanced">
        <ActionRow>
            <RadzenButton Text="Validate valid menu" Click="ValidateValidMenu" />
            <RadzenButton Text="Validate invalid menu" ButtonStyle="ButtonStyle.Warning" Click="ValidateInvalidMenu" />
        </ActionRow>
    </ApiSection>

    <ResultPanel Value="@_result" />
</div>

@code {
    private string? _result;

    private void RunPageParams()
    {
        var parameters = PageParams.From(new { Code = "DEMO" }, out var error)!;
        parameters["CustomerId"] = 42;
        dynamic values = parameters;
        values.Status = "Active";

        _result = $"Code={parameters["Code"]}; CustomerId={parameters["CustomerId"]}; Status={values.Status}; error={error?.Message ?? "none"}";
    }

    private void RunDbJson()
    {
        _result = DbJson.ToElement(new { CustomerId = 1, Name = "Template user" }).GetRawText();
    }

    private void RunMenuTree()
    {
        var menus = CreateValidConfig().Menus;
        var found = MenuTree.Find(menus, "page");
        var firstPage = MenuTree.FindFirstPage(menus);
        _result = $"Find={found?.Id}; FindFirstPage={firstPage?.Id}";
    }

    private void RunMenuTitle()
    {
        var menu = new MenuItem
        {
            Id = "customers",
            Titles = new Dictionary<string, string>
            {
                ["en"] = "Customers",
                ["vi"] = "Khách hàng"
            }
        };

        _result = $"MenuTitle.Get: {MenuTitle.Get(menu, Lang.CurrentLanguage)}";
    }

    private void RunModuleErrorId()
    {
        var exception = new InvalidOperationException("Template error");
        var errorId = ModuleErrorId.GetOrCreate(exception);
        _result = $"Created={ModuleErrorId.Create()}; GetOrCreate={errorId}";
    }

    private void ValidateValidMenu() => CaptureValidation(CreateValidConfig());

    private void ValidateInvalidMenu() => CaptureValidation(new PageConfig
    {
        Menus = [new MenuItem { Id = "invalid" }]
    });

    private void CaptureValidation(PageConfig config)
    {
        try
        {
            MenuConfigValidator.Validate(config);
            _result = "Validation succeeded.";
        }
        catch (Exception exception)
        {
            _result = $"{exception.GetType().Name}: {exception.Message}";
        }
    }

    private static PageConfig CreateValidConfig() => new()
    {
        Menus =
        [
            new MenuItem
            {
                Id = "group",
                Titles = new Dictionary<string, string> { ["en"] = "Group" },
                Children =
                [
                    new MenuItem
                    {
                        Id = "page",
                        Titles = new Dictionary<string, string> { ["en"] = "Page" },
                        Assembly = "MAP.M.Template.dll",
                        Component = "MAP.M.Template.Pages.HomePage"
                    }
                ]
            }
        ]
    };
}
