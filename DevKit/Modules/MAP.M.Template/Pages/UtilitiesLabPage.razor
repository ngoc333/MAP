@inherits BasePage
@namespace MAP.M.Template.Pages

<div class="p-4"><h2>Utilities lab <small>Synthetic, deterministic</small></h2><ApiSection Title="PageParams and navigation models"><RadzenButton Text="Run PageParams" Click="Params" /><p>Actual current: @Navigator.Current?.PageId</p></ApiSection><ApiSection Title="Menu validation and tree"><RadzenButton Text="Validate synthetic menu" Click="Menu" /></ApiSection><ApiSection Title="Header utilities"><RadzenButton Text="Run local header state" Click="HeaderUtilities" /></ApiSection><ApiSection Title="DbJson and ModuleErrorId"><RadzenButton Text="Run serialization and correlation" Click="Other" /></ApiSection><ResultPanel Value="@_result" /></div>
@code { private string? _result; private void Params(){var none=PageParams.From(null,out _);var bag=PageParams.From(new { Name="demo" },out _)!;bag["Count"]=1;dynamic d=bag;d.Enabled=true;var existing=PageParams.From(bag,out _);_result=$"null={none is null}; name={bag["Name"]}; count={bag["Count"]}; dynamic={d.Enabled}; same={ReferenceEquals(bag,existing)}; history={new PageHistoryEntry("synthetic",bag).PageId}";} private void Menu(){var page=new MenuItem{Id="page",Titles=new(){{"en","Page"}},Assembly="a",Component="c"};var config=new PageConfig{Menus=new(){new MenuItem{Id="group",Titles=new(){{"en","Group"}},Children=new(){page}}}};MenuConfigValidator.Validate(config);_result=$"find={MenuTree.Find(config.Menus,"page")?.Id}; first={MenuTree.FindFirstPage(config.Menus)?.Id}; startup={MenuTree.ResolveStartupPage(config.Menus,"page")?.Id}; title={MenuTitle.Get(page,"vi")}";} private void HeaderUtilities(){var state=new PageHeaderState();var changes=0;state.Changed+=()=>changes++;var header=new PageHeader("synthetic",HeaderKind.Compact,"TemplateHome.Title");state.Set(header);var match=PageHeaderResolver.GetMatchingHeader(Navigator.Current,header);state.Clear();_result=$"local changes={changes}; host match={(match is null ? "none" : "matched")}; kind={header.Kind}";} private void Other(){var json=DbJson.ToElement(new { CustomerId=1,FullName="Demo" });var ex=new Exception("synthetic");_result=$"json={json.GetRawText()}; errorId={ModuleErrorId.GetOrCreate(ex)}";} }
