@inherits BasePage
@namespace MAP.M.Template.Pages
@using MAP.M.Template.Models

<div class="p-4">
    <h2>@Lang.T("TemplateDatabase.Title")</h2>
    <p>@Lang.T("TemplateDatabase.OfflineNote")</p>

    <ApiSection Title="@Lang.T("TemplateDatabase.RecommendedTitle")" Note="@Lang.T("TemplateDatabase.RecommendedNote")">
        <p>@Lang.T("TemplateDatabase.ConfiguredDbName"): @MenuService.DbName</p>
        <label>@Lang.T("TemplateDatabase.Command") <input @bind="_command" /></label>
        <label class="ml-3">@Lang.T("TemplateDatabase.Parameters") <input @bind="_json" /></label>
        <ActionRow>
            <RadzenButton Text="QueryAsync&lt;DemoDbRow&gt;" Disabled="@string.IsNullOrWhiteSpace(_command)" Click="QueryAsync" />
            <RadzenButton Text="ExecuteAsync" Disabled="@string.IsNullOrWhiteSpace(_command)" Click="ExecuteAsync" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateDatabase.AdvancedTitle")" Tier="@Lang.T("TemplateCommon.Advanced")">
        <label>@Lang.T("TemplateDatabase.ExplicitDbName") <input @bind="_lowLevelDbName" /></label>
        <ActionRow>
            <RadzenButton Text="CallPostgreSqlFunctionAsync" Disabled="@string.IsNullOrWhiteSpace(_command)" Click="LowLevelFunctionAsync" />
            <RadzenButton Text="CallPostgreSqlProcedureAsync" Disabled="@string.IsNullOrWhiteSpace(_command)" Click="LowLevelProcedureAsync" />
            <RadzenButton Text="CallOracleAsync" Click="OracleAsync" />
            <RadzenButton Text="QueryPostgreSqlFunctionAsync&lt;DemoDbRow&gt;" Disabled="@string.IsNullOrWhiteSpace(_command)" Click="DirectTypedQueryAsync" />
            <RadzenButton Text="ExecutePostgreSqlProcedureAsync" Disabled="@string.IsNullOrWhiteSpace(_command)" Click="DirectTypedExecuteAsync" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="@Lang.T("TemplateDatabase.SyntheticTitle")" Tier="@Lang.T("TemplateCommon.Advanced")" Note="@Lang.T("TemplateDatabase.SyntheticNote")">
        <ActionRow>
            <RadzenButton Text="@Lang.T("TemplateDatabase.ValidArray")" Click="ShowValidSynthetic" />
            <RadzenButton Text="success != true" Click="ShowFailedSynthetic" />
            <RadzenButton Text="@Lang.T("TemplateDatabase.MissingData")" Click="ShowMissingData" />
            <RadzenButton Text="@Lang.T("TemplateDatabase.InvalidArray")" Click="ShowInvalidArray" />
            <RadzenButton Text="@Lang.T("TemplateDatabase.MappingFailure")" Click="ShowMappingFailure" />
            <RadzenButton Text="DbJson" Click="ShowDbJson" />
        </ActionRow>
    </ApiSection>
    <ResultPanel Value="@_result" />
</div>

@code {
    private string _lowLevelDbName = "";
    private string _command = "";
    private string _json = "{}";
    private string? _result;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _lowLevelDbName = MenuService.DbName ?? "";
    }

    private JsonElement Parameters() => JsonDocument.Parse(_json).RootElement.Clone();

    private Task QueryAsync() => CaptureAsync(async () =>
    {
        EnsureConfiguredDatabase();
        var rows = await base.QueryAsync<DemoDbRow>(_command, Parameters());
        return JsonSerializer.Serialize(rows);
    });

    private Task ExecuteAsync() => CaptureAsync(async () =>
    {
        EnsureConfiguredDatabase();
        await base.ExecuteAsync(_command, Parameters());
        return Lang.T("TemplateDatabase.ProcedureCompleted");
    });

    private Task LowLevelFunctionAsync() => CaptureAsync(async () =>
        (await DbClient.CallPostgreSqlFunctionAsync(_lowLevelDbName, _command, Parameters(), PageCancellationToken)).GetRawText());

    private Task LowLevelProcedureAsync() => CaptureAsync(async () =>
        (await DbClient.CallPostgreSqlProcedureAsync(_lowLevelDbName, _command, Parameters(), PageCancellationToken)).GetRawText());

    private Task OracleAsync() => CaptureAsync(async () =>
        (await DbClient.CallOracleAsync(Parameters(), PageCancellationToken)).GetRawText());

    private Task DirectTypedQueryAsync() => CaptureAsync(async () => JsonSerializer.Serialize(
        await DbClient.QueryPostgreSqlFunctionAsync<DemoDbRow>(_lowLevelDbName, _command, Parameters(), PageCancellationToken)));

    private Task DirectTypedExecuteAsync() => CaptureAsync(async () =>
    {
        await DbClient.ExecutePostgreSqlProcedureAsync(_lowLevelDbName, _command, Parameters(), PageCancellationToken);
        return Lang.T("TemplateDatabase.ProcedureCompleted");
    });

    private void ShowValidSynthetic() => _result = "Synthetic contract example: success=true, data=[{customer_id:1,full_name:'Template User'}] maps to DemoDbRow.";
    private void ShowFailedSynthetic() => _result = "Synthetic contract example: success=false raises an InvalidOperationException.";
    private void ShowMissingData() => _result = "Synthetic contract example: success=true with no data raises an InvalidOperationException.";
    private void ShowInvalidArray() => _result = "Synthetic contract example: success=true with non-array data raises an InvalidOperationException.";
    private void ShowMappingFailure() => _result = "Synthetic contract example: an incompatible array element raises a DTO mapping InvalidOperationException.";
    private void ShowDbJson() => _result = DbJson.ToElement(new { CustomerId = 1, FullName = "Template User" }).GetRawText();

    private void EnsureConfiguredDatabase()
    {
        if (MenuService.DbName is null)
            throw new InvalidOperationException("DbName is not configured.");
    }

    private async Task CaptureAsync(Func<Task<string>> action)
    {
        try
        {
            _result = await action();
        }
        catch (Exception exception)
        {
            _result = $"{exception.GetType().Name}: {exception.Message}; cancelled={PageCancellationToken.IsCancellationRequested}";
        }
    }
}
