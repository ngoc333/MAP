@inherits BasePage
@namespace MAP.M.Template.Pages
@using MAP.M.Template.Models

<div class="p-4">
    <h2>@Lang.T("TemplateDatabase.Title")</h2>
    <p>@Lang.T("TemplateDatabase.OfflineNote")</p>

    <ApiSection Title="Recommended PostgreSQL helpers" Note="No request runs until you choose an action. Errors, including an offline backend, are shown below.">
        <p>Configured DbName: @MenuService.DbName</p>
        <label>
            Command
            <input @bind="_commandName" />
        </label>
        <label class="ml-3">
            Parameters JSON
            <input @bind="_parametersJson" />
        </label>
        <ActionRow>
            <RadzenButton Text="QueryAsync&lt;DemoDbRow&gt;" Disabled="@string.IsNullOrWhiteSpace(_commandName)" Click="QueryAsync" />
            <RadzenButton Text="ExecuteAsync" Disabled="@string.IsNullOrWhiteSpace(_commandName)" Click="ExecuteAsync" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="Low-level PostgreSQL" Tier="Advanced">
        <label>
            Explicit DbName
            <input @bind="_lowLevelDbName" />
        </label>
        <ActionRow>
            <RadzenButton Text="CallPostgreSqlFunctionAsync" Disabled="@string.IsNullOrWhiteSpace(_commandName)" Click="CallPostgreSqlFunctionAsync" />
            <RadzenButton Text="CallPostgreSqlProcedureAsync" Disabled="@string.IsNullOrWhiteSpace(_commandName)" Click="CallPostgreSqlProcedureAsync" />
            <RadzenButton Text="QueryPostgreSqlFunctionAsync&lt;DemoDbRow&gt;" Disabled="@string.IsNullOrWhiteSpace(_commandName)" Click="QueryPostgreSqlFunctionAsync" />
            <RadzenButton Text="ExecutePostgreSqlProcedureAsync" Disabled="@string.IsNullOrWhiteSpace(_commandName)" Click="ExecutePostgreSqlProcedureAsync" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="Oracle" Tier="Advanced">
        <label>
            Oracle request JSON
            <input class="w-full" @bind="_oracleRequestJson" />
        </label>
        <ActionRow>
            <RadzenButton Text="DbClient.CallOracleAsync" Click="CallOracleAsync" />
        </ActionRow>
    </ApiSection>

    <ApiSection Title="DbJson">
        <p><code>DbJson.ToElement(new { CustomerId = 1 })</code></p>
        <ActionRow>
            <RadzenButton Text="Serialize example" Click="ShowDbJson" />
        </ActionRow>
    </ApiSection>

    <ResultPanel Value="@_result" />
</div>

@code {
    private string _commandName = "";
    private string _parametersJson = "{}";
    private string _lowLevelDbName = "";
    private string _oracleRequestJson = "{}";
    private string? _result;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _lowLevelDbName = MenuService.DbName ?? "";
    }

    private Task QueryAsync() => CaptureAsync(async () =>
    {
        var rows = await base.QueryAsync<DemoDbRow>(
            _commandName,
            ParseParameters(_parametersJson));
        return JsonSerializer.Serialize(rows);
    });

    private Task ExecuteAsync() => CaptureAsync(async () =>
    {
        await base.ExecuteAsync(_commandName, ParseParameters(_parametersJson));
        return "Procedure completed.";
    });

    private Task CallPostgreSqlFunctionAsync() => CaptureAsync(async () =>
        (await DbClient.CallPostgreSqlFunctionAsync(
            _lowLevelDbName,
            _commandName,
            ParseParameters(_parametersJson),
            PageCancellationToken)).GetRawText());

    private Task CallPostgreSqlProcedureAsync() => CaptureAsync(async () =>
        (await DbClient.CallPostgreSqlProcedureAsync(
            _lowLevelDbName,
            _commandName,
            ParseParameters(_parametersJson),
            PageCancellationToken)).GetRawText());

    private Task QueryPostgreSqlFunctionAsync() => CaptureAsync(async () => JsonSerializer.Serialize(
        await DbClient.QueryPostgreSqlFunctionAsync<DemoDbRow>(
            _lowLevelDbName,
            _commandName,
            ParseParameters(_parametersJson),
            PageCancellationToken)));

    private Task ExecutePostgreSqlProcedureAsync() => CaptureAsync(async () =>
    {
        await DbClient.ExecutePostgreSqlProcedureAsync(
            _lowLevelDbName,
            _commandName,
            ParseParameters(_parametersJson),
            PageCancellationToken);
        return "Procedure completed.";
    });

    private Task CallOracleAsync() => CaptureAsync(async () =>
        (await DbClient.CallOracleAsync(
            ParseParameters(_oracleRequestJson),
            PageCancellationToken)).GetRawText());

    private void ShowDbJson()
    {
        _result = DbJson.ToElement(new { CustomerId = 1 }).GetRawText();
    }

    private static JsonElement ParseParameters(string json)
    {
        using var document = JsonDocument.Parse(json);
        return document.RootElement.Clone();
    }

    private async Task CaptureAsync(Func<Task<string>> action)
    {
        try
        {
            _result = await action();
        }
        catch (Exception exception)
        {
            _result = $"{exception.GetType().Name}: {exception.Message}";
        }
    }
}
