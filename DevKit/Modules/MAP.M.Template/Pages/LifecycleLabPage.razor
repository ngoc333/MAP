@inherits BasePage
@namespace MAP.M.Template.Pages
@using MAP.M.Template.Models

<div class="p-4">
    <h2>@Lang.T("TemplateLifecycle.Title")</h2>

    <ApiSection Title="@Lang.T("TemplateLifecycle.CancellationTitle")" Note="@Lang.T("TemplateLifecycle.CancellationNote")">
        <p>@Lang.T("TemplateLifecycle.Instance"): @_instanceId | @Lang.T("TemplateLifecycle.Running"): @_running | @Lang.T("TemplateLifecycle.Ticks"): @_ticks | @Lang.T("TemplateLifecycle.Cancelled"): @PageCancellationToken.IsCancellationRequested</p>
        <p>@Lang.T("TemplateLifecycle.Initialized"): @TemplateProbeState.InitializedCount | @Lang.T("TemplateLifecycle.Navigating"): @TemplateProbeState.NavigatingCount | @Lang.T("TemplateLifecycle.CancellationObserved"): @TemplateProbeState.CancellationObservedCount | @Lang.T("TemplateLifecycle.Disposed"): @TemplateProbeState.DisposedCount</p>
        <p>@Lang.T("TemplateLifecycle.History"): @TemplateProbeState.NavigationHistory</p>
        <label class="mt-3 flex items-center gap-2"><input type="checkbox" @bind="_throwAfterCleanup" /> @Lang.T("TemplateLifecycle.ThrowAfterCleanup")</label>
        <ActionRow>
            <RadzenButton Text="@Lang.T("TemplateLifecycle.StartLoop")" Click="Start" />
            <RadzenButton Text="@Lang.T("TemplateCommon.Reset")" Click="ResetProbe" />
        </ActionRow>
        <ResultPanel Value="@_result" />
    </ApiSection>
</div>

@code {
    private readonly string _instanceId = Guid.NewGuid().ToString("N")[..8];
    private PeriodicTimer? _timer;
    private Task? _loop;
    private bool _running;
    private bool _throwAfterCleanup;
    private int _ticks;
    private string? _result;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        TemplateProbeState.Initialized(_instanceId);
        Navigator.Navigating += ObserveNavigating;
    }

    private void Start()
    {
        if (_running)
            return;

        _running = true;
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _loop = TickAsync();
    }

    private void ResetProbe() => TemplateProbeState.Reset();

    private void ObserveNavigating()
    {
        TemplateProbeState.Navigating(PageId, null);
        TemplateProbeState.CancellationObserved();
    }

    private async Task TickAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(PageCancellationToken))
            {
                _ticks++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            _result = Lang.T("TemplateLifecycle.CancelledResult");
        }
        finally
        {
            _running = false;
        }
    }

    protected override async ValueTask DisposePageAsync()
    {
        Navigator.Navigating -= ObserveNavigating;
        _timer?.Dispose();

        if (_loop is not null)
            await _loop;

        TemplateProbeState.Disposed(_instanceId);

        if (_throwAfterCleanup)
            throw new InvalidOperationException("Synthetic cleanup failure after normal cleanup.");
    }
}
