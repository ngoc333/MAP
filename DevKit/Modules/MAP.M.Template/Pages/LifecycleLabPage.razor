@inherits BasePage
@namespace MAP.M.Template.Pages
@using MAP.M.Template.Models

<div class="p-4">
    <h2>@Lang.T("TemplateLifecycle.Title")</h2>
    <p>@Lang.T("TemplateLifecycle.Description")</p>

    <ApiSection Title="@Lang.T("TemplateLifecycle.CancellationTitle")" Note="@Lang.T("TemplateLifecycle.CleanupDescription")">
        <p>Running: @_running | Ticks: @_ticks | Token cancelled: @PageCancellationToken.IsCancellationRequested</p>
        <p>Last completed cleanup: @TemplateProbeState.LastCleanup</p>
        <ActionRow>
            <RadzenButton Text="Start loop" Disabled="@_running" Click="StartLoop" />
        </ActionRow>
        <ResultPanel Value="@_result" />
    </ApiSection>
</div>

@code {
    private PeriodicTimer? _timer;
    private Task? _loop;
    private bool _running;
    private int _ticks;
    private string? _result;

    private void StartLoop()
    {
        if (_running)
            return;

        _running = true;
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _loop = RunLoopAsync();
    }

    private async Task RunLoopAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(PageCancellationToken))
            {
                _ticks++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            _result = "The page cancellation token stopped the loop.";
        }
        finally
        {
            _running = false;
        }
    }

    protected override async ValueTask DisposePageAsync()
    {
        _timer?.Dispose();

        if (_loop is not null)
            await _loop;

        TemplateProbeState.RecordCleanup();
    }
}
