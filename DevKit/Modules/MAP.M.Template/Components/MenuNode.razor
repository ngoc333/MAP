<li>
    <strong>@Item.Id</strong> — @MenuTitle.Get(Item, Lang.CurrentLanguage)
    @if (Item.IsPage)
    {
        <span> (@Item.Component)</span>
    }
    @if (Item.HasChildren)
    {
        <ul>
            @foreach (var child in Item.Children)
            {
                <MenuNode Item="child" />
            }
        </ul>
    }
</li>

@code {
    [Inject]
    private ILanguageService Lang { get; set; } = default!;

    [Parameter, EditorRequired]
    public MenuItem Item { get; set; } = default!;
}
