<header class="map-header">
    <div class="map-header__title">@Title</div>

    <div class="map-header__content">
        @Content
    </div>

    @if (CanBack && ShowBack)
    {
        <button
            type="button"
            class="map-header__back-button"
            title="Back"
            aria-label="Back"
            @onclick="OnBack">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 5 8 12l7 7" />
            </svg>
        </button>
    }

    <HeaderClock />
</header>

@code {
    [Parameter]
    public string Title { get; set; } = "MAP";

    [Parameter]
    public RenderFragment? Content { get; set; }

    [Parameter]
    public bool CanBack { get; set; }

    [Parameter]
    public bool ShowBack { get; set; } = true;

    [Parameter]
    public EventCallback OnBack { get; set; }
}
