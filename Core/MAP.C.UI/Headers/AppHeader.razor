@inject IPageHeaderState HeaderState
@inject ILanguageService Lang

<header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-6 shadow-sm flex-shrink-0">
    <div class="flex items-center gap-3">
        @NavigationControls
        <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7M4 7c0-2 1-3 3-3h10c2 0 3 1 3 3M4 7h16" />
        </svg>
        <span class="text-xl font-bold text-gray-800">@(HeaderState.Active?.Title ?? "MAP")</span>
    </div>

    <div>
        @HeaderState.Active?.Center
    </div>

    <div class="flex items-center gap-3">
        @HeaderState.Active?.End
        <LanguageSelector />
        <RadzenButton Text="@Lang.T("layout.admin", "Admin")" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
            Icon="account_circle" class="text-gray-600" />
    </div>
</header>

@code {
    [Parameter] public RenderFragment? NavigationControls { get; set; }
}
