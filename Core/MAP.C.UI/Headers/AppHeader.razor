@inject IPageHeaderState HeaderState

<header class="map-header">
    <div class="map-header__title">@(HeaderState.Active?.Title ?? "MAP")</div>

    <div class="map-header__content">
        @HeaderState.Active?.Content
    </div>

    @if (CanBack && (HeaderState.Active?.ShowBack ?? true))
    {
        <button
            type="button"
            class="map-header__back-button"
            title="Back"
            aria-label="Back"
            @onclick="OnBack">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 5 8 12l7 7" />
            </svg>
        </button>
    }

    <HeaderClock />
</header>

@code {
    [Parameter]
    public bool CanBack { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }
}
