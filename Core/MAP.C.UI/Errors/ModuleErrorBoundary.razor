@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Logging
@inject ILogger<ModuleErrorBoundary> Logger
@inject ModuleErrorNotifier ErrorNotifier

<ErrorBoundary>
    <ChildContent>
        @ChildContent
    </ChildContent>
    <ErrorContent Context="exception">
        @{HandleError(exception);}
        @* Module error - show minimal neutral content. Notification is handled by ErrorNotifier. *@
        @* User can navigate away using Header/Menu which remain functional. *@
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _errorHandled;

    private void HandleError(Exception exception)
    {
        if (_errorHandled) return;
        _errorHandled = true;

        var errorId = Guid.NewGuid().ToString("N")[..8].ToUpperInvariant();

        // Log the full exception with ErrorId
        Logger.LogError(exception,
            "Module render/lifecycle error. ErrorId={ErrorId}",
            errorId);

        // Show notification (respects config)
        ErrorNotifier.Notify(errorId);
    }
}
