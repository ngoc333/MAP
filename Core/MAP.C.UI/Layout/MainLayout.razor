@inherits LayoutComponentBase
@implements IDisposable
@inject IMenuService MenuService
@inject IPageNavigator Navigator
@inject IPageHeaderState HeaderState
@inject IAppConfigService ConfigService
@inject IUiStateService UiState
@inject ModuleErrorNotifier ErrorNotifier
@inject ILanguageService Lang
@using MAP.C.Contract.Diagnostics

<div class="flex flex-col h-screen w-screen overflow-hidden">
    @if (UiState.ShowHeader)
    {
        <AppHeader Title="@CurrentHeaderTitle"
                   Content="@CurrentPageHeader?.Content"
                   CanBack="Navigator.CanBack"
                   ShowBack="@(CurrentPageHeader?.ShowBack ?? true)"
                   OnBack="@(() => Navigator.BackAsync())" />
    }

    <div class="flex flex-1 overflow-hidden">
        @if (UiState.ShowMenu)
        {
            <AppMenu OnMenuSelected="OnMenuSelected" />
        }

        <main class="flex-1 overflow-auto bg-gray-50 p-6">
            @if (Navigator.Current is { } active)
            {
                <PageContainer Type="active.ComponentType" @key="(active, _pageGeneration)" OnFaulted="OnPageFaulted" />
            }
            else
            {
                <PageContainer Type="null" @key="(EmptyPageKey, _pageGeneration)" OnFaulted="OnPageFaulted" />
            }
        </main>
    </div>

    <RadzenDialog />
    <RadzenNotification />
</div>

@code {
    private Action? _navigatorChanged;
    private Action? _headerChanged;
    private Action? _uiStateChanged;
    private Action? _langChanged;
    private const string EmptyPageKey = "__empty";
    private string? FaultedPageId { get; set; }
    private int _pageGeneration;

    private PageHeader? CurrentPageHeader =>
        PageHeaderResolver.GetMatchingHeader(Navigator.Current, HeaderState.Active);

    private string CurrentHeaderTitle
    {
        get
        {
            var current = Navigator.Current;

            if (current is null)
                return ConfigService.Current?.ProgramId ?? "MAP";

            return PageHeaderResolver.ResolveTitle(
                current,
                HeaderState.Active,
                menuItem => MenuTitle.Get(menuItem, Lang.CurrentLanguage),
                Lang.T);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _navigatorChanged = () => InvokeAsync(StateHasChanged);
        Navigator.Changed += _navigatorChanged;
        _headerChanged = () => InvokeAsync(StateHasChanged);
        HeaderState.Changed += _headerChanged;
        _uiStateChanged = () => InvokeAsync(StateHasChanged);
        UiState.Changed += _uiStateChanged;
        _langChanged = () => InvokeAsync(StateHasChanged);
        Lang.LanguageChanged += _langChanged;

        await MenuService.LoadMenusAsync();

        // Find first navigable page using menu order
        if (Navigator.Current is null)
        {
            var firstPage = MenuTree.ResolveStartupPage(
                MenuService.Menus,
                MenuService.StartPageId);

            if (firstPage is null)
            {
                throw new InvalidOperationException(
                    "Menu does not contain any navigable page.");
            }

            await OpenRootPageSafeAsync(firstPage.Id);
        }
    }

    private void OnPageFaulted()
    {
        if (Navigator.Current is { } active)
            FaultedPageId = active.PageId;
    }

    private async Task OnMenuSelected(MenuItem menuItem)
    {
        if (!menuItem.IsPage) return;

        // Retry faulted page: recreate component tree without navigation stack change
        if (FaultedPageId == menuItem.Id)
        {
            FaultedPageId = null;
            _pageGeneration++;
            StateHasChanged();
            return;
        }

        await OpenRootPageSafeAsync(menuItem.Id);
    }

    private async Task OpenRootPageSafeAsync(string pageId, object? parameters = null)
    {
        try
        {
            await Navigator.OpenRootAsync(pageId, parameters);
            FaultedPageId = null; // clear fault on successful navigation
        }
        catch (Exception ex)
        {
            // Navigation failure: current page remains unchanged, do NOT set FaultedPageId
            // FaultedPageId only tracks RENDER faults (set via ModuleErrorBoundary → OnPageFaulted)
            var errorId = ModuleErrorId.GetOrCreate(ex);
            // Logging is owned by PageNavigator - don't duplicate here
            ErrorNotifier.Notify(errorId);
        }
    }

    public void Dispose()
    {
        if (_navigatorChanged is not null)
            Navigator.Changed -= _navigatorChanged;
        if (_headerChanged is not null)
            HeaderState.Changed -= _headerChanged;
        if (_uiStateChanged is not null)
            UiState.Changed -= _uiStateChanged;
        if (_langChanged is not null)
            Lang.LanguageChanged -= _langChanged;
    }
}
