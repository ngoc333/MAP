@inherits LayoutComponentBase
@implements IDisposable
@inject IMenuService MenuService
@inject IModuleLoader ModuleLoader
@inject IPageNavigator Navigator
@inject IPageHeaderState HeaderState
@inject ILanguageService Lang
@inject IJSRuntime Js
@inject IAppConfigService ConfigService
@inject IUiStateService UiState

<div class="flex flex-col h-screen w-screen overflow-hidden">
    @if (UiState.ShowHeader)
    {
        <AppHeader NavigationControls="NavigationControls" UiState="UiState" />
    }

    <div class="flex flex-1 overflow-hidden">
        @if (UiState.ShowMenu)
        {
            <AppMenu OnMenuSelected="OnMenuSelected" />
        }

        <main class="flex-1 overflow-auto bg-gray-50 p-6">
            @if (Navigator.Current is { } active)
            {
                <PageContainer Type="active.ComponentType" @key="@active.PageId" />
            }
            else
            {
                <PageContainer Type="null" />
            }
        </main>
    </div>

    <RadzenDialog />
</div>

@code {
    private Action? _navigatorChanged;
    private Action? _headerChanged;
    private Action? _uiStateChanged;
    private DotNetObjectReference<MainLayout>? _shortcutReference;
    private DotNetObjectReference<MainLayout>? _uiShortcutReference;

    protected override async Task OnInitializedAsync()
    {
        _navigatorChanged = () => InvokeAsync(StateHasChanged);
        Navigator.Changed += _navigatorChanged;
        _headerChanged = () => InvokeAsync(StateHasChanged);
        HeaderState.Changed += _headerChanged;
        _uiStateChanged = () => InvokeAsync(StateHasChanged);
        UiState.Changed += _uiStateChanged;
        Lang.LanguageChanged += OnLanguageChanged;
        await MenuService.LoadMenusAsync();

        if (!ConfigService.Exists)
        {
            await Navigator.OpenAsync("system-config");
        }
        else if (ConfigService.Current?.DefaultPageId is { Length: > 0 } defaultPage
                 && Navigator.Current is null)
        {
            await Navigator.OpenAsync(defaultPage);
        }
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private RenderFragment NavigationControls => builder =>
    {
        if (Navigator.CanBack)
        {
            builder.OpenComponent<RadzenButton>(0);
            builder.AddAttribute(1, "Icon", "arrow_back");
            builder.AddAttribute(2, "ButtonStyle", ButtonStyle.Light);
            builder.AddAttribute(3, "Click", EventCallback.Factory.Create<MouseEventArgs>(
                this, async _ => await Navigator.BackAsync()));
            builder.CloseComponent();
        }
    };

    private async Task OnMenuSelected(MenuItem menuItem)
    {
        if (!menuItem.IsPage) return;
        await Navigator.OpenAsync(menuItem.Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _shortcutReference = DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("mapLog.registerShortcut", _shortcutReference);
        _uiShortcutReference = DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("mapLog.registerUiShortcuts", _uiShortcutReference);
    }

    [JSInvokable]
    public Task OpenSystemLogsAsync() => Navigator.OpenAsync("system-logs");

    [JSInvokable]
    public Task ToggleMenu()
    {
        UiState.ToggleMenu();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task ToggleHeader()
    {
        UiState.ToggleHeader();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        if (_navigatorChanged is not null)
            Navigator.Changed -= _navigatorChanged;
        if (_headerChanged is not null)
            HeaderState.Changed -= _headerChanged;
        if (_uiStateChanged is not null)
            UiState.Changed -= _uiStateChanged;
        Lang.LanguageChanged -= OnLanguageChanged;
        _shortcutReference?.Dispose();
        _uiShortcutReference?.Dispose();
    }
}
