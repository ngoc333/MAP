<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Radzen.Blazor" Version="11.1.7" />
  </ItemGroup>

  <!-- Platform references (cố định) -->
  <ItemGroup>
    <ProjectReference Include="..\Core\MAP.C.Contract\MAP.C.Contract.csproj" />
    <ProjectReference Include="..\Core\MAP.C.Runtime\MAP.C.Runtime.csproj" />
    <ProjectReference Include="..\Core\MAP.C.UI\MAP.C.UI.csproj" />
    <ProjectReference Include="..\Core\MAP.C.Wasm\MAP.C.Wasm.csproj" />
  </ItemGroup>

  <!-- Tự động phát hiện tất cả Page DLL từ Modules -->
  <ItemGroup>
    <PageAssembly Include="Modules\*.dll" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="@(PageAssembly->'%(Filename)')">
      <HintPath>%(PageAssembly.Identity)</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="@(PageAssembly->Count()) &gt; 0">
    <BlazorWebAssemblyLazyLoad Include="@(PageAssembly->'%(Filename)')" />
  </ItemGroup>

  <Target Name="EnsureTailwindCli" BeforeTargets="BuildTailwindCss">
    <PropertyGroup>
      <TailwindExe>$(MSBuildProjectDirectory)\..\tools\tailwindcss.exe</TailwindExe>
      <TailwindUrl>https://github.com/tailwindlabs/tailwindcss/releases/download/v3.4.17/tailwindcss-windows-x64.exe</TailwindUrl>
    </PropertyGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\tools" Condition="!Exists('$(MSBuildProjectDirectory)\..\tools')" />
    <Exec
      Command="powershell -NoProfile -Command &quot;Invoke-WebRequest -Uri '$(TailwindUrl)' -OutFile '$(TailwindExe)' -UseBasicParsing&quot;"
      Condition="!Exists('$(TailwindExe)')" />
  </Target>

  <Target Name="BuildTailwindCss" BeforeTargets="BeforeBuild" DependsOnTargets="EnsureTailwindCli">
    <Exec
      Command="..\tools\tailwindcss.exe -i Styles\tailwind-input.css -o wwwroot\css\tailwind.css --minify"
      WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
