<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <WebModulesDir>$(MSBuildProjectDirectory)\Modules\</WebModulesDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <!-- Platform references -->
  <ItemGroup>
    <ProjectReference Include="..\Core\MAP.C.Wasm\MAP.C.Wasm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ModuleProject Include="$(MSBuildProjectDirectory)\..\Modules\*\*.csproj" />
    <ProjectReference Include="@(ModuleProject)" />
    <BlazorWebAssemblyLazyLoad Include="@(ModuleProject->'%(Filename).dll')" />
    <None Include="..\Shared\Config\page.json" Link="wwwroot\page.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Shared\Config\db-api.json" Link="wwwroot\db-api.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Shared\Scripts\app-log.js" Link="wwwroot\js\app-log.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Shared\Scripts\app-config.js" Link="wwwroot\js\app-config.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Shared\Styles\tailwind.css" Link="wwwroot\css\tailwind.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="UseSharedConfigurationStaticWebAssets" AfterTargets="ResolveStaticWebAssetsInputs">
    <ItemGroup>
      <_SharedConfigurationAsset Include="$(MSBuildProjectDirectory)\..\Shared\Config\page.json">
        <RelativePath>page.json</RelativePath>
      </_SharedConfigurationAsset>
      <_SharedConfigurationAsset Include="$(MSBuildProjectDirectory)\..\Shared\Config\db-api.json">
        <RelativePath>db-api.json</RelativePath>
      </_SharedConfigurationAsset>
    </ItemGroup>

    <DefineStaticWebAssets CandidateAssets="@(_SharedConfigurationAsset)"
                           SourceId="$(PackageId)"
                           SourceType="Computed"
                           AssetKind="All"
                           AssetMode="All"
                           AssetRole="Primary"
                           CopyToOutputDirectory="PreserveNewest"
                           CopyToPublishDirectory="PreserveNewest"
                           ContentRoot="$(MSBuildProjectDirectory)\..\Shared\Config\"
                           BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="_SharedConfigurationStaticWebAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints CandidateAssets="@(_SharedConfigurationStaticWebAsset)"
                                   ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_SharedConfigurationStaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <ItemGroup>
      <StaticWebAsset Include="@(_SharedConfigurationStaticWebAsset)" />
      <StaticWebAssetEndpoint Include="@(_SharedConfigurationStaticWebAssetEndpoint)" />
    </ItemGroup>
  </Target>

  <Target Name="UseSharedScriptsStaticWebAssets" AfterTargets="ResolveStaticWebAssetsInputs">
    <ItemGroup>
      <_SharedScriptAsset Include="$(MSBuildProjectDirectory)\..\Shared\Scripts\app-log.js">
        <RelativePath>js/app-log.js</RelativePath>
      </_SharedScriptAsset>
      <_SharedScriptAsset Include="$(MSBuildProjectDirectory)\..\Shared\Scripts\app-config.js">
        <RelativePath>js/app-config.js</RelativePath>
      </_SharedScriptAsset>
    </ItemGroup>

    <DefineStaticWebAssets CandidateAssets="@(_SharedScriptAsset)"
                           SourceId="$(PackageId)"
                           SourceType="Computed"
                           AssetKind="All"
                           AssetMode="All"
                           AssetRole="Primary"
                           CopyToOutputDirectory="PreserveNewest"
                           CopyToPublishDirectory="PreserveNewest"
                           ContentRoot="$(MSBuildProjectDirectory)\..\Shared\Scripts\"
                           BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="_SharedScriptStaticWebAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints CandidateAssets="@(_SharedScriptStaticWebAsset)"
                                   ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_SharedScriptStaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <ItemGroup>
      <StaticWebAsset Include="@(_SharedScriptStaticWebAsset)" />
      <StaticWebAssetEndpoint Include="@(_SharedScriptStaticWebAssetEndpoint)" />
    </ItemGroup>
  </Target>

  <Target Name="UseSharedStylesStaticWebAssets" AfterTargets="ResolveStaticWebAssetsInputs">
    <ItemGroup>
      <_SharedStyleAsset Include="$(MSBuildProjectDirectory)\..\Shared\Styles\tailwind.css">
        <RelativePath>css/tailwind.css</RelativePath>
      </_SharedStyleAsset>
      <_SharedStyleAsset Include="$(MSBuildProjectDirectory)\..\Shared\Styles\inter.css">
        <RelativePath>css/inter.css</RelativePath>
      </_SharedStyleAsset>
      <_SharedStyleAsset Include="$(MSBuildProjectDirectory)\..\Shared\Styles\app.css">
        <RelativePath>css/app.css</RelativePath>
      </_SharedStyleAsset>
    </ItemGroup>

    <DefineStaticWebAssets CandidateAssets="@(_SharedStyleAsset)"
                           SourceId="$(PackageId)"
                           SourceType="Computed"
                           AssetKind="All"
                           AssetMode="All"
                           AssetRole="Primary"
                           CopyToOutputDirectory="PreserveNewest"
                           CopyToPublishDirectory="PreserveNewest"
                           ContentRoot="$(MSBuildProjectDirectory)\..\Shared\Styles\"
                           BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="_SharedStyleStaticWebAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints CandidateAssets="@(_SharedStyleStaticWebAsset)"
                                   ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_SharedStyleStaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <ItemGroup>
      <StaticWebAsset Include="@(_SharedStyleStaticWebAsset)" />
      <StaticWebAssetEndpoint Include="@(_SharedStyleStaticWebAssetEndpoint)" />
    </ItemGroup>
  </Target>

  <Target Name="UseSharedFontsStaticWebAssets" AfterTargets="ResolveStaticWebAssetsInputs">
    <ItemGroup>
      <_SharedFontAsset Include="$(MSBuildProjectDirectory)\..\Shared\Fonts\Inter\Inter-latin.woff2">
        <RelativePath>fonts/inter/Inter-latin.woff2</RelativePath>
      </_SharedFontAsset>
      <_SharedFontAsset Include="$(MSBuildProjectDirectory)\..\Shared\Fonts\Inter\Inter-latin-ext.woff2">
        <RelativePath>fonts/inter/Inter-latin-ext.woff2</RelativePath>
      </_SharedFontAsset>
      <_SharedFontAsset Include="$(MSBuildProjectDirectory)\..\Shared\Fonts\Inter\Inter-vietnamese.woff2">
        <RelativePath>fonts/inter/Inter-vietnamese.woff2</RelativePath>
      </_SharedFontAsset>
    </ItemGroup>

    <DefineStaticWebAssets CandidateAssets="@(_SharedFontAsset)"
                           SourceId="$(PackageId)"
                           SourceType="Computed"
                           AssetKind="All"
                           AssetMode="All"
                           AssetRole="Primary"
                           CopyToOutputDirectory="PreserveNewest"
                           CopyToPublishDirectory="PreserveNewest"
                           ContentRoot="$(MSBuildProjectDirectory)\..\Shared\Fonts\Inter\"
                           BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="_SharedFontStaticWebAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints CandidateAssets="@(_SharedFontStaticWebAsset)"
                                   ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_SharedFontStaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <ItemGroup>
      <StaticWebAsset Include="@(_SharedFontStaticWebAsset)" />
      <StaticWebAssetEndpoint Include="@(_SharedFontStaticWebAssetEndpoint)" />
    </ItemGroup>
  </Target>

  <Target Name="BuildAndSyncModules" BeforeTargets="ResolveReferences">
    <MSBuild Projects="@(ModuleProject)"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="_ModuleAssembly" />
    </MSBuild>

    <MakeDir Directories="$(WebModulesDir)" />
    <Copy SourceFiles="@(_ModuleAssembly)" DestinationFolder="$(WebModulesDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ModuleAssembly->'%(RootDir)%(Directory)%(Filename).pdb')"
          DestinationFolder="$(WebModulesDir)"
           SkipUnchangedFiles="true" />

  </Target>

</Project>
